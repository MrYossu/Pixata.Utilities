<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Company>Pixata Ltd</Company>
    <Authors>Avrohom Yisroel Silver</Authors>
    <Product>Pixata.Pdf.Documents</Product>
    <Description>Turns Word documents (.docx), RTF, HTML, text files and pictures (PNG and JPEG) into PDFs, such as a CV uploaded in whatever format the person had, keeping headings, bold and italic, lists, tables and pictures. Pure .NET, with no Chromium, Office or other native dependency, so it runs on ordinary hosting</Description>
    <Copyright>Copyright 2026 Pixata Ltd</Copyright>
    <ProjectUrl>https://github.com/MrYossu/Pixata.Utilities/tree/master/Pixata.Pdf.Documents</ProjectUrl>
    <PackageProjectUrl>https://github.com/MrYossu/Pixata.Utilities/tree/master/Pixata.Pdf.Documents</PackageProjectUrl>
    <PackageIcon>pdf.png</PackageIcon>
    <PackageTags>C# PDF convert Word docx RTF HTML image PNG JPEG CV</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="pdf.png" Pack="true" PackagePath="\" />
    <None Include="Readme.md" Pack="True" PackagePath="\" />
    <!-- The fonts' licence, which has to go with them -->
    <None Include="Fonts\OFL.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liberation Sans (SIL Open Font License), used when the caller doesn't give fonts of their own. It has Latin, Greek,
         Cyrillic and Hebrew letters, which PDF's built-in Helvetica hasn't, and is the same size as Arial -->
    <EmbeddedResource Include="Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pixata.Pdf.Documents.Tests" />
  </ItemGroup>

</Project>
