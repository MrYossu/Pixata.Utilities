<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
    <Company>Pixata Ltd</Company>
    <Authors>Avrohom Yisroel Silver</Authors>
    <Product>Pixata.Blazor.PdfViewer</Product>
    <Description>A PDF viewer for Blazor, with page navigation, zoom, rotation, text search, download and print, using PDF.js. Users can mark it up with notes, highlights, strike-through, drawing and text, kept apart from the PDF.</Description>
    <Copyright>Copyright 2026 Pixata Ltd</Copyright>
    <ProjectUrl>https://github.com/MrYossu/Pixata.Utilities/tree/master/Pixata.Blazor.PdfViewer</ProjectUrl>
    <PackageProjectUrl>https://github.com/MrYossu/Pixata.Utilities/tree/master/Pixata.Blazor.PdfViewer</PackageProjectUrl>
    <PackageIcon>pdfviewer.png</PackageIcon>
    <PackageTags>C# Blazor PDF Viewer PDF.js annotation markup</PackageTags>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pdfviewer.png" Pack="true" PackagePath="\" />
    <None Include="Readme.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pixata.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pixata.Blazor\Pixata.Blazor.csproj" />
    <ProjectReference Include="..\Pixata.Extensions\Pixata.Extensions.csproj" />
  </ItemGroup>

</Project>
