@namespace Pixata.Blazor.Components
@typeparam TValue
@inherits PixataInputBase<TValue>

@*
  A checkbox for a bool or bool? value. It is a button with role="checkbox" rather than a native checkbox, so it can show the
  indeterminate state without any script. Space and Enter toggle it, and it can go inside a label or be pointed at by one
*@
<button type="button"
        role="checkbox"
        id="@Id"
        class="@CssClass"
        tabindex="@TabIndex"
        disabled="@(!Enabled)"
        aria-checked="@(IsIndeterminate ? "mixed" : IsChecked ? "true" : "false")"
        aria-invalid="@(IsInvalid ? "true" : null)"
        aria-label="@AriaLabel"
        aria-labelledby="@AriaLabelledBy"
        aria-describedby="@AriaDescribedBy"
        @onclick="Toggle"
        @attributes="AdditionalAttributes"></button>
