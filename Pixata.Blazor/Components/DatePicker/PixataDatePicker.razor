@namespace Pixata.Blazor.Components
@typeparam TValue
@inherits PixataDateInputBase<TValue>
@using System.Globalization
@using Microsoft.JSInterop

@* A date input with a button that opens a calendar, as in Telerik's DatePicker. With ShowTime, the popup has a time selector too *@
<span @ref="_wrapper" class="@WrapperClass" style="@WidthStyle">
  <input @ref="InputElement"
         class="pixata-blazor-dateinput-input"
         id="@Id"
         type="text"
         role="combobox"
         value="@InitialText"
         placeholder="@Placeholder"
         inputmode="@EffectiveInputMode"
         autocomplete="off"
         disabled="@(!Enabled)"
         readonly="@ReadOnly"
         tabindex="@TabIndex"
         aria-haspopup="@(ShowTime ? "dialog" : "grid")"
         aria-expanded="@(_open ? "true" : "false")"
         aria-invalid="@(IsInvalid ? "true" : null)"
         @onkeydown="OnInputKeyDown" />
  @if (ShowClearButton && IsNullable && HasValue && Enabled && !ReadOnly) {
    <span class="pixata-blazor-dateinput-clear" role="button" title="Clear" aria-label="Clear" @onclick="Clear">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m8 7.3 3.6-3.6.7.7L8.7 8l3.6 3.6-.7.7L8 8.7l-3.6 3.6-.7-.7L7.3 8 3.7 4.4l.7-.7z" /></svg>
    </span>
  }
  <button type="button"
          class="pixata-blazor-datepicker-button"
          tabindex="-1"
          aria-label="Open"
          disabled="@(!Enabled || ReadOnly)"
          @onclick="Toggle">
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 1h1v2h4V1h1v2h3v12H2V3h3zm8 5H3v8h10zM3 5h10V4H3zm1 2h2v2H4zm3 0h2v2H7zm3 0h2v2h-2zm-6 3h2v2H4zm3 0h2v2H7z" /></svg>
  </button>
  @if (_open) {
    <div @ref="_popup" class="@DatePickerCss.Join("pixata-blazor-datepicker-popup", ShowTime ? "pixata-blazor-datetimepicker-popup" : null, PopupClass)">
      <PixataCalendar @ref="_calendar"
                      Value="@(ShowTime ? _pendingDate : CurrentDate)"
                      ValueChanged="OnCalendarChanged"
                      Min="Min"
                      Max="Max"
                      View="View"
                      BottomView="BottomView"
                      DisabledDates="DisabledDates"
                      ShowWeekNumbers="ShowWeekNumbers"
                      ShowOtherMonthDays="ShowOtherMonthDays"
                      OnEscape="CloseAndFocus" />
      @if (ShowTime) {
        <div class="pixata-blazor-timeselector" @onkeydown="OnTimeKeyDown">
          <div class="pixata-blazor-timeselector-lists">
            <div class="pixata-blazor-timeselector-list" role="listbox" aria-label="@HoursText">
              @foreach (int hour in HourOptions) {
                <button type="button" role="option" class="@OptionClass(hour == DisplayHour)" aria-selected="@(hour == DisplayHour ? "true" : "false")"
                        @onclick="() => SetHour(hour)">@hour.ToString("00", CultureInfo.CurrentCulture)</button>
              }
            </div>
            <div class="pixata-blazor-timeselector-list" role="listbox" aria-label="@MinutesText">
              @foreach (int minute in MinuteOptions) {
                <button type="button" role="option" class="@OptionClass(minute == _pendingTime.Minutes)" aria-selected="@(minute == _pendingTime.Minutes ? "true" : "false")"
                        @onclick="() => SetMinute(minute)">@minute.ToString("00", CultureInfo.CurrentCulture)</button>
              }
            </div>
            @if (TimeHasSeconds) {
              <div class="pixata-blazor-timeselector-list" role="listbox" aria-label="@SecondsText">
                @foreach (int second in Enumerable.Range(0, 60)) {
                  <button type="button" role="option" class="@OptionClass(second == _pendingTime.Seconds)" aria-selected="@(second == _pendingTime.Seconds ? "true" : "false")"
                          @onclick="() => SetSecond(second)">@second.ToString("00", CultureInfo.CurrentCulture)</button>
                }
              </div>
            }
            @if (IsTwelveHour) {
              <div class="pixata-blazor-timeselector-list" role="listbox" aria-label="@AmPmText">
                <button type="button" role="option" class="@OptionClass(!IsPm)" aria-selected="@(!IsPm ? "true" : "false")" @onclick="() => SetPm(false)">@CultureInfo.CurrentCulture.DateTimeFormat.AMDesignator</button>
                <button type="button" role="option" class="@OptionClass(IsPm)" aria-selected="@(IsPm ? "true" : "false")" @onclick="() => SetPm(true)">@CultureInfo.CurrentCulture.DateTimeFormat.PMDesignator</button>
              </div>
            }
          </div>
          <div class="pixata-blazor-timeselector-footer">
            <button type="button" class="@PixataCss.Button(PixataThemeConstants.Button.ThemeColor.Base, null, null, PixataThemeConstants.Size.Small)" @onclick="CloseAndFocus">@CancelText</button>
            <button type="button" class="@PixataCss.Button(PixataThemeConstants.Button.ThemeColor.Primary, null, null, PixataThemeConstants.Size.Small)" @onclick="SetDateAndTime">@SetText</button>
          </div>
        </div>
      }
    </div>
  }
</span>

@code {
  /// <summary>
  /// The view the calendar opens in. Defaults to <see cref="PixataCalendarView.Month"/>
  /// </summary>
  [Parameter]
  public PixataCalendarView View { get; set; } = PixataCalendarView.Month;

  /// <summary>
  /// The most detailed view the calendar shows, where clicking a cell picks it
  /// </summary>
  [Parameter]
  public PixataCalendarView BottomView { get; set; } = PixataCalendarView.Month;

  /// <summary>
  /// Dates the user can't pick from the calendar
  /// </summary>
  [Parameter]
  public List<DateTime>? DisabledDates { get; set; }

  [Parameter]
  public bool ShowWeekNumbers { get; set; }

  [Parameter]
  public bool ShowOtherMonthDays { get; set; } = true;

  /// <summary>
  /// A CSS class for the popup
  /// </summary>
  [Parameter]
  public string? PopupClass { get; set; }

  [Parameter]
  public EventCallback OnOpen { get; set; }

  [Parameter]
  public EventCallback OnClose { get; set; }

  /// <summary>
  /// Lets the user pick a time as well as a date. The popup gets hour and minute lists (and seconds and AM/PM if the format
  /// has them) next to the calendar, with Set and Cancel buttons, and the format defaults to the culture's short date and
  /// time. Only for <see cref="DateTime"/> values. Defaults to false
  /// </summary>
  [Parameter]
  public bool ShowTime { get; set; }

  /// <summary>
  /// With <see cref="ShowTime"/>, the gap in minutes between the times in the minutes list. Defaults to 1. Any minute can
  /// still be typed
  /// </summary>
  [Parameter]
  public int TimeStep { get; set; } = 1;

  /// <summary>
  /// The text of the button that sets the date and time, for translating. Defaults to "Set"
  /// </summary>
  [Parameter]
  public string SetText { get; set; } = "Set";

  /// <summary>
  /// The text of the button that closes the popup without changing the value, for translating. Defaults to "Cancel"
  /// </summary>
  [Parameter]
  public string CancelText { get; set; } = "Cancel";

  /// <summary>
  /// The accessible names of the time lists, for translating. Default to "Hours", "Minutes", "Seconds" and "AM/PM"
  /// </summary>
  [Parameter]
  public string HoursText { get; set; } = "Hours";

  [Parameter]
  public string MinutesText { get; set; } = "Minutes";

  [Parameter]
  public string SecondsText { get; set; } = "Seconds";

  [Parameter]
  public string AmPmText { get; set; } = "AM/PM";

  private static readonly Type UnderlyingType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

  private ElementReference _wrapper;
  private ElementReference _popup;
  private PixataCalendar? _calendar;
  private DotNetObjectReference<PixataDatePicker<TValue>>? _pickerRef;
  private bool _open;
  private bool _justOpened;
  private bool _formatSet;
  // With ShowTime, what the user has picked in the popup, which only becomes the value when they click Set
  private DateTime _pendingDate;
  private TimeSpan _pendingTime;

  private string WrapperClass =>
    DatePickerCss.Join("pixata-blazor-dateinput", "pixata-blazor-datepicker", SizeClass, IsInvalid ? "pixata-blazor-dateinput-invalid" : null,
                       Enabled ? null : "pixata-blazor-dateinput-disabled", _open ? "pixata-blazor-datepicker-open" : null, Class);

  private string? WidthStyle =>
    Width is null ? null : $"width: {Width}";

  // The culture's short date and time, unless the page sets a Format
  protected override string EffectiveFormat =>
    ShowTime && !_formatSet ? "g" : Format;

  private bool FormatHas(DateInputModel.SegmentType type) =>
    Model.Segments.Any(s => s.Type == type);

  private bool IsTwelveHour =>
    FormatHas(DateInputModel.SegmentType.AmPm) || Model.Segments.Any(s => s.Type == DateInputModel.SegmentType.Hour && s.Format[0] == 'h');

  private bool TimeHasSeconds =>
    FormatHas(DateInputModel.SegmentType.Second);

  private bool IsPm =>
    _pendingTime.Hours >= 12;

  private IEnumerable<int> HourOptions =>
    IsTwelveHour ? [12, .. Enumerable.Range(1, 11)] : Enumerable.Range(0, 24);

  private int DisplayHour =>
    IsTwelveHour ? (_pendingTime.Hours % 12 == 0 ? 12 : _pendingTime.Hours % 12) : _pendingTime.Hours;

  private IEnumerable<int> MinuteOptions =>
    Enumerable.Range(0, 60).Where(m => m % Math.Max(1, TimeStep) == 0);

  private static string OptionClass(bool selected) =>
    DatePickerCss.Join("pixata-blazor-timeselector-option", selected ? "pixata-blazor-timeselector-option-selected" : null);

  public override Task SetParametersAsync(ParameterView parameters) {
    _formatSet |= parameters.TryGetValue(nameof(Format), out string? _);
    return base.SetParametersAsync(parameters);
  }

  protected override void OnInitialized() {
    base.OnInitialized();
    if (ShowTime && UnderlyingType == typeof(DateOnly)) {
      throw new InvalidOperationException("PixataDatePicker can't use ShowTime with a DateOnly value, which has no time. Use DateTime or DateTime? instead");
    }
  }

  /// <summary>
  /// Opens the calendar
  /// </summary>
  public async Task Open() {
    if (_open || !Enabled || ReadOnly) {
      return;
    }
    DateTime start = CurrentDate ?? DateTime.Today;
    _pendingDate = start.Date;
    _pendingTime = start.TimeOfDay;
    _open = true;
    _justOpened = true;
    await OnOpen.InvokeAsync();
    StateHasChanged();
  }

  /// <summary>
  /// Closes the calendar
  /// </summary>
  public async Task Close() {
    // Cleared even when closed, in case the popup is closed before it has been rendered
    _justOpened = false;
    if (!_open) {
      return;
    }
    _open = false;
    if (Module is not null) {
      try {
        await Module.InvokeVoidAsync("closePopup", _popup);
      } catch (JSException) {
        // The popup has already gone from the page
      } catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException) {
        // The page has gone
      }
    }
    await OnClose.InvokeAsync();
    StateHasChanged();
  }

  [JSInvokable]
  public async Task ClosePopup() =>
    await Close();

  protected override async Task OnAfterRenderAsync(bool firstRender) {
    await base.OnAfterRenderAsync(firstRender);
    if (_justOpened && _open && Module is not null) {
      _justOpened = false;
      _pickerRef ??= DotNetObjectReference.Create(this);
      try {
        await Module.InvokeVoidAsync("openPopup", _wrapper, _popup, _pickerRef);
        if (ShowTime) {
          await Module.InvokeVoidAsync("scrollSelectedOptionsIntoView", _popup);
        }
        // The keyboard focus goes into the calendar, so the arrow keys move around it
        if (_calendar is not null) {
          await _calendar.FocusAsync();
        }
      } catch (JSException) {
        // The popup was closed again before it could be positioned
      } catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException) {
        // The page has gone
      }
    }
  }

  private async Task Toggle() {
    if (_open) {
      await CloseAndFocus();
    } else {
      await Open();
    }
  }

  private async Task CloseAndFocus() {
    await Close();
    await FocusAsync();
  }

  private async Task OnCalendarChanged(DateTime date) {
    if (ShowTime) {
      // Picking a day keeps the time, and the popup stays open until Set
      _pendingDate = date.Date;
      return;
    }
    await SetValue(date);
    await CloseAndFocus();
    await RaiseChangeIfNeeded();
  }

  private void SetHour(int hour) {
    int hour24 = IsTwelveHour ? hour % 12 + (IsPm ? 12 : 0) : hour;
    _pendingTime = new(hour24, _pendingTime.Minutes, _pendingTime.Seconds);
  }

  private void SetMinute(int minute) =>
    _pendingTime = new(_pendingTime.Hours, minute, _pendingTime.Seconds);

  private void SetSecond(int second) =>
    _pendingTime = new(_pendingTime.Hours, _pendingTime.Minutes, second);

  private void SetPm(bool pm) {
    if (pm != IsPm) {
      _pendingTime = _pendingTime.Add(TimeSpan.FromHours(pm ? 12 : -12));
    }
  }

  private async Task SetDateAndTime() {
    DateTime chosen = _pendingDate.Date + _pendingTime;
    // Min and Max include the time, so a time outside them is brought back to the nearest one allowed
    DateTime clamped = chosen < Min ? Min : chosen > Max ? Max : chosen;
    await SetValue(clamped);
    await CloseAndFocus();
    await RaiseChangeIfNeeded();
  }

  private async Task OnTimeKeyDown(KeyboardEventArgs e) {
    if (e.Key == "Escape") {
      await CloseAndFocus();
    }
  }

  // Alt+Down opens the calendar, and Alt+Up or Escape closes it, as in Telerik's date picker
  private async Task OnInputKeyDown(KeyboardEventArgs e) {
    switch (e.Key) {
      case "ArrowDown" when e.AltKey:
        await Open();
        break;
      case "ArrowUp" when e.AltKey:
      case "Escape":
        await Close();
        break;
      case "Enter":
        await RaiseChangeIfNeeded();
        break;
    }
  }

  public override async ValueTask DisposeAsync() {
    if (_open && Module is not null) {
      try {
        await Module.InvokeVoidAsync("closePopup", _popup);
      } catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException) {
        // The circuit has gone
      }
    }
    _pickerRef?.Dispose();
    await base.DisposeAsync();
  }
}
