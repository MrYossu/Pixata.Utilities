@typeparam TValue

<div class="hebrew-date-picker pixata-position-relative @Class" style="@($"width: {Width}")">
  <div class="pixata-input-group">
    <input class="pixata-form-control" placeholder="dd/MM/yyyy or d MMM yyyy" value="@_textValue" @onfocus="OpenOnFocusInput" @onclick="OpenOnFocusInput" readonly />
    <button class="pixata-btn" type="button" aria-label="Show calendar" aria-expanded="@_calendarOpen" @onclick="ToggleCalendar">
      <svg xmlns="http://www.w3.org/2000/svg"
           width="1em"
           height="1em"
           viewBox="0 0 24 24"
           fill="none"
           stroke="currentColor"
           stroke-width="2"
           stroke-linecap="round"
           stroke-linejoin="round"
           aria-hidden="true">

        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>

        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="16" y1="2" x2="16" y2="6"></line>

        <line x1="3" y1="10" x2="21" y2="10"></line>

        <circle cx="7.5" cy="14" r="0.75"></circle>
        <circle cx="12" cy="14" r="0.75"></circle>
        <circle cx="16.5" cy="14" r="0.75"></circle>

        <circle cx="7.5" cy="18" r="0.75"></circle>
        <circle cx="12" cy="18" r="0.75"></circle>
        <circle cx="16.5" cy="18" r="0.75"></circle>
      </svg>
    </button>
  </div>
  @if (ShowDiagnostics) {
    <div class="pixata-mt-1"><small>@Diagnostics()</small></div>
  }

  @if (_calendarOpen) {
    <!-- overlay to capture outside clicks and close the popup -->
    <div class="overlay-content" @onclick="CloseCalendar"></div>

    <div class="pixata-card @(OpenOnRight ? "open-right" : "open-left")" role="dialog" aria-modal="true" aria-label="Choose a date">
      <div class="pixata-card-header">
        @if (GregorianPrimary) {
          <div class="pixata-d-flex pixata-justify-content-between pixata-align-items-center">
            <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link nav-btn" aria-label="Previous month" @onclick="PrevGregorianMonth">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
              </svg>
            </button>
            <div class="pixata-d-flex pixata-align-items-center pixata-gap-1">
              <strong>@(new DateTime(_displayGregorianYear, _displayGregorianMonth, 1).ToString("MMMM"))</strong>
              <select class="pixata-form-select pixata-form-select-sm" style="width: 90px;" @bind="DisplayGregorianYear">
                @foreach (int y in GregorianYears) {
                  <option value="@y">@y</option>
                }
              </select>
            </div>
            <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link nav-btn" aria-label="Next month" @onclick="NextGregorianMonth">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" />
              </svg>
            </button>
          </div>
          <div class="pixata-text-center pixata-small pixata-text-muted pixata-px-2 pixata-pt-1">@HebrewMonthsLabel</div>
        } else {
          <div class="pixata-d-flex pixata-justify-content-between pixata-align-items-center">
            <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link nav-btn" aria-label="Previous month" @onclick="PrevHebrewMonth">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
              </svg>
            </button>
            <div class="pixata-d-flex pixata-align-items-center pixata-gap-1">
              <strong>@_displayHebrewMonthName</strong>
              <select class="pixata-form-select pixata-form-select-sm" style="width: 120px;" @bind="DisplayHebrewYear">
                @foreach (int y in Years) {
                  <option value="@y">@y</option>
                }
              </select>
            </div>
            <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link nav-btn" aria-label="Next month" @onclick="NextHebrewMonth">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" />
              </svg>
            </button>
          </div>
          @if (ShowSecondaryDates) {
            <div class="pixata-text-center pixata-small pixata-text-muted pixata-px-2 pixata-pt-1">@GregorianMonthsLabel</div>
          }
        }
      </div>
      <div class="pixata-card-body pixata-p-2">
        @if (GregorianPrimary) {
          <div class="pixata-small pixata-text-muted hebrew-days-header">
            <div>SU</div>
            <div>MO</div>
            <div>TU</div>
            <div>WE</div>
            <div>TH</div>
            <div>FR</div>
            <div>SA</div>
          </div>
        } else {
          <div class="pixata-small pixata-text-muted hebrew-days-header" style="direction: rtl;">
            <div>&#x05D0;</div>
            <div>&#x05D1;</div>
            <div>&#x05D2;</div>
            <div>&#x05D3;</div>
            <div>&#x05D4;</div>
            <div>&#x05D5;</div>
            <div>&#x05E9;</div>
          </div>
        }
        <div class="pixata-mt-1 grid-cells" style="@(GregorianPrimary ? "" : "direction: rtl;")">
          @if (GregorianPrimary) {
            foreach (CalendarCell[] week in GregorianCalendarWeeks()) {
              foreach (CalendarCell cell in week) {
                DateTime greg = cell.GregorianDate;
                int hebYear = cell.HebrewYear;
                int hebMonth = cell.HebrewMonth;
                int hebDay = _hc.GetDayOfMonth(greg);
                bool isToday = greg.Date == DateTime.Today;
                bool isSelected = IsSelectedDate(greg.Date);
                HebrewDateType hebrewDateType = GetHebrewDateType(hebYear, hebMonth, hebDay, greg);
                string dayClass = (isSelected ? "pixata-btn-primary pixata-text-white" : isToday ? "pixata-btn-outline-secondary today" : "pixata-btn-light") + (cell.IsCurrentMonth ? " current-month" : " ");
                string tooltip = ShowTooltips ? GetDayTooltip(hebYear, hebMonth, hebDay, greg) : "";
                string dayStyle = GetDayStyle(hebrewDateType, isSelected, isToday) + (cell.IsCurrentMonth ? "" : "opacity: 0.4;");
                <div class="pixata-text-center">
                  <button type="button"
                          class="pixata-btn pixata-btn-sm pixata-w-100 day-cell @dayClass"
                          style="@dayStyle"
                          title="@tooltip"
                          aria-label="@(string.IsNullOrEmpty(tooltip) ? null : tooltip)"
                          aria-current="@(isToday ? "date" : null)"
                          aria-pressed="@isSelected"
                          @onclick="() => SelectGregorianDay(greg)">
                    @if (ShowSecondaryDates) {
                      <div style="line-height: 1;">@cell.Day</div>
                      <div style="line-height: 1; font-size: .75em; opacity: .75;">@($"{(ShowSecondaryDatesInBrackets ? "(" : "")}{hebDay.ToHebrew()}{(ShowSecondaryDatesInBrackets ? ")" : "")}")</div>
                    } else {
                      @cell.Day
                    }
                  </button>
                </div>
              }
            }
          } else {
            foreach (CalendarCell[] week in HebrewCalendarWeeks()) {
              foreach (CalendarCell cell in week) {
                DateTime greg = cell.GregorianDate;
                int hebYear = cell.HebrewYear;
                int hebMonth = cell.HebrewMonth;
                int hebDay = cell.Day;
                bool isToday = greg.Date == DateTime.Today;
                bool isSelected = IsSelectedDate(greg.Date);
                HebrewDateType hebrewDateType = GetHebrewDateType(hebYear, hebMonth, hebDay, greg);
                string dayClass = (isSelected ? "pixata-btn-primary pixata-text-white" : isToday ? "pixata-btn-outline-secondary today" : "pixata-btn-light") + (cell.IsCurrentMonth ? " current-month" : " ");
                string tooltip = ShowTooltips ? GetDayTooltip(hebYear, hebMonth, hebDay, greg) : "";
                string dayStyle = GetDayStyle(hebrewDateType, isSelected, isToday) + (cell.IsCurrentMonth ? "" : "opacity: 0.4;");
                <div class="pixata-text-center">
                  <button type="button"
                          class="pixata-btn pixata-btn-sm pixata-w-100 day-cell @dayClass"
                          style="@dayStyle"
                          title="@tooltip"
                          aria-label="@(string.IsNullOrEmpty(tooltip) ? null : tooltip)"
                          aria-current="@(isToday ? "date" : null)"
                          aria-pressed="@isSelected"
                          @onclick="() => SelectHebrewDay(greg)">
                    @if (ShowSecondaryDates) {
                      <div style="line-height: 1; font-size: 1.1em;">@hebDay.ToHebrew()</div>
                      <div style="line-height: 1; font-size: .65em; opacity: .75;">@($"{(ShowSecondaryDatesInBrackets ? "(" : "")}{greg.Day}{(ShowSecondaryDatesInBrackets ? ")" : "")}")</div>
                    } else {
                      @hebDay.ToHebrew()
                    }
                  </button>
                </div>
              }
            }
          }
        </div>
      </div>
      <div class="pixata-card-footer pixata-d-flex pixata-justify-content-between pixata-align-items-center">
        @if (typeof(TValue) == typeof(DateTime?)) {
          <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link" style="text-decoration: none" @onclick="ClearSelection">Clear</button>
        } else {
          <div></div>
        }
        <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link" style="text-decoration: none" @onclick="SelectToday">Today</button>
        <!-- On phones the popup is a sheet over the page, so it needs a visible way out. Larger screens close it by clicking away. -->
        <button type="button" class="pixata-btn pixata-btn-sm pixata-btn-link close-btn" style="text-decoration: none" @onclick="CloseCalendar">Close</button>
      </div>
    </div>
  }

  <style>
      /* The Width parameter sets the picker's width, but it must never push its container wider than the screen */
      .hebrew-date-picker {
        max-width: 100%;
      }

      .hebrew-date-picker .pixata-input-group .pixata-btn {
        background-color: #e4e7eb
      }

      /* The input is readonly and opens the calendar, so it shouldn't look like somewhere to type */
      .hebrew-date-picker .pixata-input-group .pixata-form-control {
        cursor: pointer;
      }

      .hebrew-date-picker .hebrew-days-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        gap: .25rem;
      }

      .hebrew-date-picker .overlay-content {
        position: fixed;
        inset: 0;
        z-index: 2000;
        /* Stops a swipe on the backdrop scrolling the page behind the popup */
        touch-action: none;
      }

      .hebrew-date-picker .pixata-card {
        position: absolute;
        width: 320px;
        max-width: calc(100vw - 1rem);
        direction: ltr;
        z-index: 2001;
        -webkit-user-select: none;
        user-select: none;
      }

      .hebrew-date-picker .pixata-card.open-left {
        left: 0;
      }

      .hebrew-date-picker .pixata-card.open-right {
        right: 0;
      }

      .hebrew-date-picker .grid-cells {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: .25rem;
      }

      .hebrew-date-picker .current-month {
        border: 1px solid #dee2e6;
      }

      /* Tapping a day shouldn't leave the grey flash some mobile browsers add */
      .hebrew-date-picker .pixata-card .pixata-btn {
        -webkit-tap-highlight-color: transparent;
      }

      .hebrew-date-picker .day-cell {
        min-height: 2.25rem;
      }

      .hebrew-date-picker .nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.25rem;
        min-height: 2.25rem;
      }

      /* Only needed when the calendar covers the page as a sheet, see the media queries below */
      .hebrew-date-picker .close-btn {
        display: none;
      }

      /* Keeps the month controls and buttons in view when a small screen makes the popup scroll.
         Has no effect on larger screens, where the popup is never taller than its content. */
      .hebrew-date-picker .pixata-card-header,
      .hebrew-date-picker .pixata-card-footer {
        position: sticky;
        z-index: 1;
        /* An opaque colour under Bootstrap's semi-transparent cap, so content can't show through */
        background-color: var(--bs-card-bg, #fff);
        background-image: linear-gradient(var(--bs-card-cap-bg, rgba(0, 0, 0, .03)), var(--bs-card-cap-bg, rgba(0, 0, 0, .03)));
      }

      .hebrew-date-picker .pixata-card-header {
        top: 0;
      }

      .hebrew-date-picker .pixata-card-footer {
        bottom: 0;
      }

      /* Phones: show the calendar as a sheet anchored to the bottom of the screen, rather than a
         320px popup hanging off whatever corner of the layout the input happens to sit in. */
      @@media (max-width: 575.98px) {
        .hebrew-date-picker .overlay-content {
          background-color: rgba(0, 0, 0, .4);
        }

        .hebrew-date-picker .pixata-card,
        .hebrew-date-picker .pixata-card.open-left,
        .hebrew-date-picker .pixata-card.open-right {
          position: fixed;
          top: auto;
          right: 0;
          bottom: 0;
          left: 0;
          width: auto;
          max-width: none;
          max-height: 85vh;
          max-height: 85dvh;
          overflow-y: auto;
          overscroll-behavior: contain;
          border-bottom-left-radius: 0;
          border-bottom-right-radius: 0;
          padding-bottom: env(safe-area-inset-bottom);
          animation: hebrew-date-picker-slide-up .18s ease-out;
        }

        /* On a wide phone, full width cells look stretched, so cap the grid and centre it */
        .hebrew-date-picker .hebrew-days-header,
        .hebrew-date-picker .grid-cells {
          max-width: 26rem;
          margin-left: auto;
          margin-right: auto;
        }

        /* Finger sized targets */
        .hebrew-date-picker .day-cell {
          min-height: 2.75rem;
          font-size: 1rem;
        }

        .hebrew-date-picker .nav-btn {
          min-width: 2.75rem;
          min-height: 2.75rem;
        }

        .hebrew-date-picker .pixata-card-header .pixata-form-select,
        .hebrew-date-picker .pixata-card-footer .pixata-btn {
          min-height: 2.75rem;
        }

        .hebrew-date-picker .close-btn {
          display: inline-block;
        }
      }

      /* Landscape phones have room across but not down, so centre the sheet and let it scroll */
      @@media (max-height: 500px) and (orientation: landscape) {
        .hebrew-date-picker .overlay-content {
          background-color: rgba(0, 0, 0, .4);
        }

        .hebrew-date-picker .pixata-card,
        .hebrew-date-picker .pixata-card.open-left,
        .hebrew-date-picker .pixata-card.open-right {
          position: fixed;
          top: .5rem;
          right: auto;
          bottom: .5rem;
          left: 50%;
          transform: translateX(-50%);
          width: min(20rem, calc(100vw - 1rem));
          max-width: none;
          max-height: none;
          overflow-y: auto;
          overscroll-behavior: contain;
          padding-bottom: env(safe-area-inset-bottom);
          animation: none;
        }

        .hebrew-date-picker .close-btn {
          display: inline-block;
        }
      }

      @@keyframes hebrew-date-picker-slide-up {
        from {
          transform: translateY(100%);
        }

        to {
          transform: translateY(0);
        }
      }

      @@media (prefers-reduced-motion: reduce) {
        .hebrew-date-picker .pixata-card {
          animation: none;
        }
      }
  </style>
</div>