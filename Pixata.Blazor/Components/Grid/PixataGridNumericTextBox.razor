@using System.ComponentModel
@using System.Globalization
@attribute [EditorBrowsable(EditorBrowsableState.Never)]

@* A number box with up and down buttons, like Telerik's NumericTextBox, for the grid's filters *@
<span class="pixata-blazor-grid-numeric">
  <input class="pixata-blazor-grid-input-inner"
         type="text"
         inputmode="decimal"
         aria-label="@AriaLabel"
         role="spinbutton"
         value="@_text"
         @oninput="OnInput"
         @onkeydown="OnKeyDown" />
  <span class="pixata-blazor-grid-numeric-spinner">
    <button type="button" class="pixata-blazor-grid-numeric-increase" tabindex="-1" title="Increase value" aria-label="Increase value" @onclick="() => Step(1)">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 10h8L8 5z" /></svg>
    </button>
    <button type="button" class="pixata-blazor-grid-numeric-decrease" tabindex="-1" title="Decrease value" aria-label="Decrease value" @onclick="() => Step(-1)">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6h8l-4 5z" /></svg>
    </button>
  </span>
</span>

@code {
  [Parameter]
  public decimal? Value { get; set; }

  [Parameter]
  public EventCallback<decimal?> ValueChanged { get; set; }

  [Parameter]
  public string? AriaLabel { get; set; }

  private string _text = "";
  private decimal? _lastValue;

  protected override void OnParametersSet() {
    // Only replaces the text when the value changes from outside, so what the user is typing (such as "1.") isn't reformatted
    if (Value != _lastValue) {
      _lastValue = Value;
      _text = Value?.ToString(CultureInfo.CurrentCulture) ?? "";
    }
  }

  private async Task OnInput(ChangeEventArgs e) {
    _text = e.Value?.ToString() ?? "";
    decimal? value = decimal.TryParse(_text, NumberStyles.Number, CultureInfo.CurrentCulture, out decimal parsed) ? parsed : null;
    await SetValue(value);
  }

  private async Task Step(int delta) {
    decimal value = (Value ?? 0) + delta;
    _text = value.ToString(CultureInfo.CurrentCulture);
    await SetValue(value);
  }

  private async Task OnKeyDown(KeyboardEventArgs e) {
    if (e.Key is "ArrowUp" or "ArrowDown") {
      await Step(e.Key == "ArrowUp" ? 1 : -1);
    }
  }

  private async Task SetValue(decimal? value) {
    if (value != Value) {
      Value = value;
      _lastValue = value;
      await ValueChanged.InvokeAsync(value);
    }
  }
}
