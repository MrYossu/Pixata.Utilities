@typeparam TItem
@using System.ComponentModel
@using System.Globalization
@using Pixata.Blazor.Components
@using Pixata.Extensions.Grid

@* The columns render nothing; they just register with the grid. The table is deferred so it renders after they have done so.
   The cascade covers the table too, so that things in the toolbar, such as the search box, can find the grid *@
<CascadingValue Value="this" IsFixed="true">
  @GridSettings
  @GridAggregates
  @GridColumns
  <PixataGridDefer>
    @{
      List<PixataGridColumn<TItem>> columns = RenderedColumns();
    }
    <div class="@Css.Join(GridClass, DragToSelect ? "pixata-blazor-grid-drag-select" : null)" style="@GridStyle" id="@_gridId" @onmouseup="DragEnd">
      @if (GridToolBarTemplate is not null) {
        <div class="pixata-blazor-grid-toolbar" role="toolbar" aria-label="Grid toolbar">
          @GridToolBarTemplate
        </div>
      }
      @if (Pageable && PagerPosition == PixataGridPagerPosition.Top) {
        @Pager
      }
      @if (Groupable) {
        @GroupPanel
      }
      <div class="pixata-blazor-grid-content">
        <table class="pixata-blazor-grid-table">
          <colgroup>
            @for (int level = 0; level < GroupLevels; level++) {
              <col class="pixata-blazor-grid-group-col" />
            }
            @foreach (PixataGridColumn<TItem> column in columns) {
              <col style="@column.WidthStyle" />
            }
          </colgroup>
          <thead class="pixata-blazor-grid-thead">
            <tr>
              @for (int level = 0; level < GroupLevels; level++) {
                <th class="pixata-blazor-grid-th pixata-blazor-grid-group-cell" aria-hidden="true"></th>
              }
              @foreach (PixataGridColumn<TItem> column in columns) {
                if (column is PixataGridCheckboxColumn<TItem> checkboxColumn) {
                  <th class="@Css.Join(column.HeaderCellClass, "pixata-blazor-grid-checkbox-cell")" scope="col">
                    @if (checkboxColumn.SelectAll && SelectionMode == PixataGridSelectionMode.Multiple) {
                      <input type="checkbox"
                             class="@Css.Join("pixata-blazor-checkbox", !AllSelected(checkboxColumn) && SomeSelected(checkboxColumn) ? "pixata-blazor-checkbox-indeterminate" : null)"
                             checked="@AllSelected(checkboxColumn)"
                             aria-label="Select all rows"
                             @onclick="() => SelectAllClicked(checkboxColumn)" />
                    }
                  </th>
                  continue;
                }
                bool sortable = CanSort(column);
                GridSortDescriptor? sort = sortable ? SortFor(column) : null;
                bool menu = FilterMode == PixataGridFilterMode.FilterMenu && CanFilter(column);
                <th class="@Css.Join(column.HeaderCellClass, sortable ? "pixata-blazor-grid-sortable" : null, sort is null ? null : "pixata-blazor-grid-sorted", menu ? "pixata-blazor-grid-filterable" : null, CanGroup(column) ? "pixata-blazor-grid-group-draggable" : null)"
                    data-pixata-group-field="@(CanGroup(column) ? column.Field : null)"
                    data-pixata-group-title="@(CanGroup(column) ? column.HeaderText : null)"
                    scope="col"
                    aria-sort="@(sort is null ? null : sort.SortDirection == ListSortDirection.Ascending ? "ascending" : "descending")"
                    tabindex="@(sortable ? "0" : null)"
                    @onclick="() => OnHeaderClick(column)"
                    @onkeydown="e => OnHeaderKeyDown(e, column)">
                  <span class="pixata-blazor-grid-cell-inner">
                    <span class="pixata-blazor-grid-link">
                      <span class="pixata-blazor-grid-column-title">
                        @if (column.HeaderTemplate is null) {
                          @column.HeaderText
                        } else {
                          @column.HeaderTemplate
                        }
                      </span>
                      @if (sort is not null) {
                        <span class="pixata-blazor-grid-sort-icon" aria-hidden="true">
                          @if (sort.SortDirection == ListSortDirection.Ascending) {
                            <svg viewBox="0 0 16 16"><path d="M7 6v7h1V6h3L7.5 2 4 6z" /></svg>
                          } else {
                            <svg viewBox="0 0 16 16"><path d="M7 10V3h1v7h3l-3.5 4L4 10z" /></svg>
                          }
                        </span>
                        @if (SortMode == PixataGridSortMode.Multiple) {
                          <span class="pixata-blazor-grid-sort-order">@(_sorts.IndexOf(sort) + 1)</span>
                        }
                      }
                    </span>
                    @if (menu) {
                      <span id="@MenuAnchorId(column)"
                            class="@Css.Join("pixata-blazor-grid-header-menu", "pixata-blazor-grid-filter-menu-button", HasFilter(column) ? "pixata-blazor-grid-filter-active" : null)"
                            role="button"
                            tabindex="-1"
                            title="@($"{column.HeaderText} column filter menu settings")"
                            aria-label="@($"{column.HeaderText} column filter menu settings")"
                            aria-haspopup="dialog"
                            aria-expanded="@(_menuColumn == column ? "true" : "false")"
                            @onclick="() => ToggleFilterMenu(column)"
                            @onclick:stopPropagation="true">
                        @FilterIcon
                      </span>
                    }
                    @if (sort is not null) {
                      <span class="pixata-blazor-visually-hidden">@(sort.SortDirection == ListSortDirection.Ascending ? PixataGridMessages.SortedAscending : PixataGridMessages.SortedDescending)</span>
                    }
                  </span>
                </th>
              }
            </tr>
            @if (FilterMode == PixataGridFilterMode.FilterRow) {
              <tr class="pixata-blazor-grid-filter-row">
                @for (int level = 0; level < GroupLevels; level++) {
                  <td class="pixata-blazor-grid-filter-cell pixata-blazor-grid-group-cell" aria-hidden="true"></td>
                }
                @foreach (PixataGridColumn<TItem> column in columns) {
                  <td class="pixata-blazor-grid-filter-cell" aria-label="@($"{column.HeaderText} filter")">
                    @if (CanFilter(column)) {
                      @FilterCell(column)
                    }
                  </td>
                }
              </tr>
            }
          </thead>
          <tbody>
            @{
              int span = Math.Max(columns.Count + GroupLevels, 1);
              _rowIndex = 0;
            }
            @if (_readError is not null) {
              <tr class="pixata-blazor-grid-norecords pixata-blazor-grid-error">
                <td class="pixata-blazor-grid-td" colspan="@span" role="alert">@_readError</td>
              </tr>
            } else if (_editing && _isNew && EditMode == PixataGridEditMode.Inline && _editItem is not null) {
              @EditRow(_editItem, columns)
            } else if (IsNewInCellRow) {
              <tr class="pixata-blazor-grid-row pixata-blazor-grid-edit-row">
                @GroupCells(GroupLevels)
                @foreach (PixataGridColumn<TItem> column in columns) {
                  @InCellCell(_editItem!, column)
                }
                @Validator
              </tr>
            }
            @if (_readError is null && _items.Count == 0 && !(_editing && _isNew && EditMode is PixataGridEditMode.Inline or PixataGridEditMode.InCell)) {
              <tr class="pixata-blazor-grid-norecords">
                <td class="pixata-blazor-grid-td" colspan="@span">
                  @if (NoDataTemplate is null) {
                    @PixataGridMessages.NoRecords
                  } else {
                    @NoDataTemplate
                  }
                </td>
              </tr>
            } else if (_readError is null && _resultGroups is { Count: > 0 }) {
              @GroupRows(_resultGroups, "", 0, columns)
            } else if (_readError is null) {
              @foreach (TItem item in _items) {
                @DataRow(item, columns)
              }
            }
          </tbody>
          @if (HasFooter(columns)) {
            <tfoot class="pixata-blazor-grid-tfoot">
              <tr class="pixata-blazor-grid-footer-row">
                @GroupCells(GroupLevels)
                @foreach (PixataGridColumn<TItem> column in columns) {
                  <td class="@column.CellClass">
                    @if (column.FooterTemplate is not null) {
                      @column.FooterTemplate(PixataGridAggregateTemplateContext.For<PixataGridAggregateTemplateContext>(column.Field, _resultAggregates))
                    }
                  </td>
                }
              </tr>
            </tfoot>
          }
        </table>
        @* Inside the scrolling area and under the sticky header, so it covers the rows but not the headers, as Telerik's does *@
        @if (_showLoader) {
          <div class="pixata-blazor-grid-loader" role="status" aria-label="Loading">
            <div class="pixata-blazor-grid-loader-overlay"></div>
            @if (LoaderTemplate is null) {
              <div class="pixata-blazor-loader">
                <span class="pixata-blazor-loader-segment"></span>
                <span class="pixata-blazor-loader-segment"></span>
                <span class="pixata-blazor-loader-segment"></span>
              </div>
            } else {
              <div class="pixata-blazor-grid-loader-template">@LoaderTemplate</div>
            }
          </div>
        }
      </div>
      @if (Pageable && PagerPosition == PixataGridPagerPosition.Bottom) {
        @Pager
      }
      @if (_menuColumn is not null) {
        @FilterMenu(_menuColumn)
      }
      @if (_editing && EditMode == PixataGridEditMode.Popup && _editItem is not null) {
        @PopupEditor(_editItem)
      }
      @if (_confirmingDelete) {
        <div class="pixata-blazor-dialog-wrapper">
          <div class="pixata-blazor-overlay"></div>
          <div class="pixata-blazor-window pixata-blazor-dialog" role="alertdialog" aria-modal="true" aria-labelledby="@($"{_gridId}-delete-title")">
            <div class="pixata-blazor-window-titlebar">
              <span class="pixata-blazor-window-title" id="@($"{_gridId}-delete-title")">@PixataGridMessages.Delete</span>
            </div>
            <div class="pixata-blazor-window-content">@PixataGridMessages.ConfirmDelete</div>
            <div class="pixata-blazor-window-actions pixata-blazor-window-actions-end">
              <button type="button" class="pixata-blazor-button pixata-blazor-button-solid pixata-blazor-button-primary" @onclick="() => ConfirmDeleteAnswered(true)">@PixataGridMessages.Ok</button>
              <button type="button" class="pixata-blazor-button pixata-blazor-button-solid" @onclick="() => ConfirmDeleteAnswered(false)">@PixataGridMessages.Cancel</button>
            </div>
          </div>
        </div>
      }
    </div>
  </PixataGridDefer>
</CascadingValue>

@code {
  private PixataGridPagerPosition PagerPosition =>
    PagerSettings?.Position ?? PixataGridPagerPosition.Bottom;

  private RenderFragment Pager =>
    @<PixataGridPager Page="_page"
                      PageSize="_pageSize"
                      Total="_total"
                      ButtonCount="@(PagerSettings?.ButtonCount ?? 10)"
                      PageSizes="PagerSettings?.PageSizes"
                      InputType="@(PagerSettings?.InputType ?? PixataGridPagerInputType.Buttons)"
                      Adaptive="@(PagerSettings?.Adaptive ?? true)"
                      PageChanged="OnPageChanged"
                      PageSizeChanged="OnPageSizeChanged" />;

  // The panel that headers are dragged into to group by them, showing a chip for each group
  private RenderFragment GroupPanel =>
    @<div class="pixata-blazor-grid-group-panel" role="toolbar" aria-label="@PixataGridMessages.GroupPanelLabel">
      @if (_groups.Count > 0) {
        <div class="pixata-blazor-grid-group-chips" role="listbox" aria-label="@PixataGridMessages.GroupPanelLabel" aria-orientation="horizontal">
          @for (int i = 0; i < _groups.Count; i++) {
            int index = i;
            GridGroupDescriptor group = _groups[index];
            string title = ColumnFor(group.Member)?.HeaderText ?? group.Member;
            <div class="pixata-blazor-grid-group-chip pixata-blazor-grid-group-draggable"
                 data-pixata-group-index="@index"
                 data-pixata-group-title="@title"
                 role="option"
                 tabindex="0"
                 aria-selected="true"
                 title="@title"
                 @onkeydown="e => GroupChipKeyDown(e, index)">
              <span class="pixata-blazor-grid-group-chip-content">
                <span class="pixata-blazor-grid-group-chip-label">@title</span>
              </span>
              <span class="pixata-blazor-grid-group-chip-remove"
                    role="button"
                    title="@PixataGridMessages.Remove"
                    aria-label="@($"{PixataGridMessages.Remove} {title}")"
                    @onclick="() => Ungroup(group.Member)"
                    @onclick:stopPropagation="true">
                @PixataGridIcons.For(PixataGridIcon.XCircle)
              </span>
            </div>
          }
        </div>
      }
      <div class="pixata-blazor-grid-group-hint">@(_groups.Count == 0 ? PixataGridMessages.GroupPanelEmpty : "")</div>
    </div>;

  // Delete or Backspace on a chip stops grouping by its field
  private void GroupChipKeyDown(KeyboardEventArgs e, int index) {
    if (e.Key is "Delete" or "Backspace") {
      Ungroup(_groups[index].Member);
    }
  }

  // The empty cells down the left of the table, one for each group level
  private static RenderFragment GroupCells(int count) =>
    @<text>
      @for (int i = 0; i < count; i++) {
        <td class="pixata-blazor-grid-td pixata-blazor-grid-group-cell"></td>
      }
    </text>;

  // A group's header row, its items or subgroups, and its footer row. Each level is indented by one more group cell
  private RenderFragment GroupRows(List<GridGroup<TItem>> groups, string parent, int level, List<PixataGridColumn<TItem>> columns) =>
    @<text>
      @foreach (GridGroup<TItem> group in groups) {
        string path = GroupPath(parent, group);
        bool expanded = !_collapsedGroups.Contains(path);
        PixataGridColumn<TItem>? groupColumn = ColumnFor(group.Member);
        <tr class="pixata-blazor-grid-group-row" aria-expanded="@(expanded ? "true" : "false")">
          @GroupCells(level)
          <td class="pixata-blazor-grid-td pixata-blazor-grid-group-header" colspan="@(columns.Count + GroupLevels - level)">
            <p class="pixata-blazor-grid-group-header-inner">
              <span class="pixata-blazor-grid-group-toggle"
                    role="button"
                    tabindex="0"
                    aria-label="@(expanded ? PixataGridMessages.Collapse : PixataGridMessages.Expand)"
                    @onclick="() => ToggleGroup(path)"
                    @onkeydown="e => GroupToggleKeyDown(e, path)">
                @PixataGridIcons.For(expanded ? PixataGridIcon.CaretDown : PixataGridIcon.CaretRight)
              </span>
              @if (groupColumn?.GroupHeaderTemplate is not null) {
                @groupColumn.GroupHeaderTemplate(GroupContext(group, group.Member))
              } else {
                @GroupTitle(group)
              }
            </p>
          </td>
        </tr>
        @if (expanded) {
          if (level + 1 < GroupLevels) {
            @GroupRows(group.Subgroups, path, level + 1, columns)
          } else {
            foreach (TItem item in group.Items) {
              @DataRow(item, columns)
            }
          }
        }
        @* As in Telerik's grid, the footer stays when the group is collapsed *@
        @if (HasGroupFooters(columns)) {
          <tr class="pixata-blazor-grid-group-footer">
            @GroupCells(GroupLevels)
            @foreach (PixataGridColumn<TItem> column in columns) {
              <td class="@column.CellClass">
                @if (column.GroupFooterTemplate is not null) {
                  @column.GroupFooterTemplate(GroupContext(group, column.Field))
                }
              </td>
            }
          </tr>
        }
      }
    </text>;

  // A row for an item: the row template, the row being edited, or the normal cells
  private RenderFragment DataRow(TItem item, List<PixataGridColumn<TItem>> columns) {
    int index = _rowIndex++;
    if (RowTemplate is not null) {
      return
        @<tr class="@RowClass(item, index)"
            @onclick="e => RowClicked(OnRowClick, item, e, null)"
            @ondblclick="e => RowClicked(OnRowDoubleClick, item, e, null)"
            @oncontextmenu="e => RowClicked(OnRowContextMenu, item, e, null)"
            @oncontextmenu:preventDefault="OnRowContextMenu.HasDelegate">
          @GroupCells(GroupLevels)
          @RowTemplate(item)
        </tr>;
    }
    if (IsEditing(item)) {
      return EditRow(_editItem!, columns);
    }
    bool rowSelected = SelectionType == PixataGridSelectionType.Row && IsSelected(item);
    return
      @<tr class="@Css.Join(RowClass(item, index), rowSelected ? "pixata-blazor-grid-selected" : null, IsInCellRow(item) ? "pixata-blazor-grid-edit-row" : null)" aria-selected="@(SelectionMode == PixataGridSelectionMode.None ? null : rowSelected ? "true" : "false")">
        @GroupCells(GroupLevels)
        @if (IsInCellRow(item)) {
          @Validator
        }
        @foreach (PixataGridColumn<TItem> column in columns) {
          if (IsCellEditing(item, column)) {
            @InCellCell(_editItem!, column)
            continue;
          }
          <td class="@Css.Join(column.CellClassFor(item), column is PixataGridCheckboxColumn<TItem> ? "pixata-blazor-grid-checkbox-cell" : null, column is PixataGridCommandColumn<TItem> ? "pixata-blazor-grid-command-cell" : null, SelectionType == PixataGridSelectionType.Cell && IsCellSelected(item, column.Field) ? "pixata-blazor-grid-selected" : null)"
              @onclick="e => CellClicked(item, column, e)"
              @ondblclick="e => RowClicked(OnRowDoubleClick, item, e, column.Field)"
              @oncontextmenu="e => RowClicked(OnRowContextMenu, item, e, column.Field)"
              @oncontextmenu:preventDefault="OnRowContextMenu.HasDelegate"
              @onmousedown="e => DragStart(item, column, e)"
              @onmouseover="e => DragOver(item, column, e)">
            @if (column is PixataGridCommandColumn<TItem> commandColumn) {
              <CascadingValue Value="RowContext(item)">
                @commandColumn.ChildContent
              </CascadingValue>
            } else if (column is PixataGridCheckboxColumn<TItem>) {
              <input type="checkbox"
                     class="pixata-blazor-checkbox"
                     checked="@IsSelected(item)"
                     aria-label="Select a row"
                     @onclick="() => CheckboxClicked(item)"
                     @onclick:stopPropagation="true" />
            } else if (column.Template is null) {
              @column.CellText(item)
            } else {
              @column.Template(item)
            }
          </td>
        }
      </tr>;
  }

  // A click raises OnRowClick, and then selects the row or cell, or starts editing it
  private async Task CellClicked(TItem item, PixataGridColumn<TItem> column, MouseEventArgs e) {
    await RowClicked(OnRowClick, item, e, column.Field);
    await RowSelectionClick(item, e);
    await CellSelectionClick(item, column, e);
    if (EditMode == PixataGridEditMode.InCell && column is not PixataGridCommandColumn<TItem> and not PixataGridCheckboxColumn<TItem>) {
      await StartCellEdit(item, column);
    }
  }

  // A cell of the row being edited a cell at a time. The cell being edited shows its editor; clicking another one moves there
  private RenderFragment InCellCell(TItem editItem, PixataGridColumn<TItem> column) {
    if (column is PixataGridCommandColumn<TItem> commandColumn) {
      return
        @<td class="@Css.Join(column.CellClass, "pixata-blazor-grid-command-cell")">
          <CascadingValue Value="RowContext(_isNew ? editItem : _originalEditItem!)">
            @commandColumn.ChildContent
          </CascadingValue>
        </td>;
    }
    if (column.Field is not null && column.Field == _editField) {
      return
        @<td id="@EditCellId" class="@Css.Join(column.CellClass, "pixata-blazor-grid-edit-cell")" @onkeydown="EditCellKeyDown">
          @Editor(column, editItem)
        </td>;
    }
    return
      @<td class="@column.CellClass" @onclick="() => StartCellEdit(_isNew ? editItem : _originalEditItem!, column)">
        @if (column.Template is null) {
          @column.CellText(editItem)
        } else {
          @column.Template(editItem)
        }
      </td>;
  }

  // A row being edited inline. The validator is keyed on the edit context, so a new one is created for each edit
  private RenderFragment EditRow(TItem editItem, List<PixataGridColumn<TItem>> columns) =>
    @<tr class="pixata-blazor-grid-row pixata-blazor-grid-edit-row">
      @GroupCells(GroupLevels)
      @foreach (PixataGridColumn<TItem> column in columns) {
        @if (column is PixataGridCommandColumn<TItem> commandColumn) {
          <td class="@Css.Join(column.CellClass, "pixata-blazor-grid-command-cell")">
            <CascadingValue Value="RowContext(_isNew ? editItem : _originalEditItem!)">
              @commandColumn.ChildContent
            </CascadingValue>
          </td>
        } else if (CanEdit(column)) {
          <td class="@Css.Join(column.CellClass, "pixata-blazor-grid-edit-cell")">
            @Editor(column, editItem)
          </td>
        } else {
          <td class="@column.CellClass">@column.CellText(editItem)</td>
        }
      }
      @Validator
    </tr>;

  private RenderFragment Validator =>
    @<CascadingValue @key="_editContext" Value="_editContext" IsFixed="true">
      @if (ValidationSettings?.ValidatorTemplate is not null) {
        @ValidationSettings.ValidatorTemplate
      } else if (ValidationSettings?.Enabled ?? true) {
        <DataAnnotationsValidator />
      }
    </CascadingValue>;

  // An editor for one field of the item being edited, suited to its type, and shown as invalid when validation fails
  private RenderFragment Editor(PixataGridColumn<TItem> column, TItem editItem) {
    if (column.EditorTemplate is not null) {
      return column.EditorTemplate(editItem);
    }
    object? value = EditValue(column);
    string? message = ValidationMessage(column);
    string? invalid = message is null ? null : "pixata-blazor-grid-invalid";
    string label = column.HeaderText;
    return EditorTypeFor(column) switch {
      PixataGridEditorType.NumericTextBox =>
        @<span class="@Css.Join("pixata-blazor-grid-editor", invalid)" title="@message">
          <PixataGridNumericTextBox Value="ToDecimal(value)" ValueChanged="d => SetEditValue(column, FromDecimal(column, d))" AriaLabel="@label" />
        </span>,
      PixataGridEditorType.DatePicker =>
        @<span class="@Css.Join("pixata-blazor-grid-editor", invalid)" title="@message">
          <PixataDatePicker TValue="DateTime?" Value="ToDate(value)" ValueChanged="d => SetEditValue(column, FromDate(column, d))" Class="pixata-blazor-grid-filter-date" />
        </span>,
      PixataGridEditorType.CheckBox =>
        @<span class="@Css.Join("pixata-blazor-grid-editor", invalid)" title="@message">
          <input type="checkbox" class="pixata-blazor-checkbox" checked="@(value is true)" aria-label="@label" @onchange="e => SetEditValue(column, e.Value is true)" />
        </span>,
      PixataGridEditorType.DropDownList =>
        @<span class="@Css.Join("pixata-blazor-grid-editor", invalid)" title="@message">
          <PixataGridDropDownList TValue="object" Items="EnumItems(column)" Value="value" ValueChanged="v => SetEditValue(column, v)" AriaLabel="@label" Class="pixata-blazor-grid-filter-editor" />
        </span>,
      PixataGridEditorType.TextArea =>
        @<span class="@Css.Join("pixata-blazor-grid-textbox", "pixata-blazor-grid-textarea", invalid)" title="@message">
          <textarea class="pixata-blazor-grid-input-inner" aria-label="@label" aria-invalid="@(message is null ? null : "true")" @oninput="e => SetEditValue(column, e.Value?.ToString())">@(value as string)</textarea>
        </span>,
      _ =>
        @<span class="@Css.Join("pixata-blazor-grid-textbox", invalid)" title="@message">
          <input class="pixata-blazor-grid-input-inner" type="text" value="@(Convert.ToString(value, CultureInfo.CurrentCulture))" aria-label="@label" aria-invalid="@(message is null ? null : "true")" @oninput="e => SetEditValue(column, e.Value?.ToString())" />
        </span>
    };
  }

  // The popup window for editing. Escape cancels, as in Telerik's grid
  private RenderFragment PopupEditor(TItem editItem) {
    PixataGridPopupEditFormSettings<TItem>? form = PopupEditFormSettings;
    string? style = Css.Join(PopupEditSettings?.Width is string width ? $"width: {width};" : null, PopupEditSettings?.MaxHeight is string height ? $"max-height: {height};" : null);
    string buttonsLayout = (form?.ButtonsLayout ?? PixataGridFormButtonsLayout.Start).ToString().ToLowerInvariant();
    return
      @<div class="pixata-blazor-dialog-wrapper">
        <div class="pixata-blazor-overlay"></div>
        <div class="@Css.Join("pixata-blazor-window", "pixata-blazor-grid-popup-edit", PopupEditSettings?.Class)" style="@(style == "" ? null : style)" role="dialog" aria-modal="true" aria-labelledby="@($"{_gridId}-edit-title")" tabindex="0" @onkeydown="PopupKeyDown">
          <div class="pixata-blazor-window-titlebar">
            <span class="pixata-blazor-window-title" id="@($"{_gridId}-edit-title")">@PopupTitle</span>
            <button type="button" class="pixata-blazor-button pixata-blazor-button-icon pixata-blazor-window-close" title="@PixataGridMessages.Close" aria-label="@PixataGridMessages.Close" @onclick="CancelEditCommand">
              @PixataGridIcons.For(PixataGridIcon.X)
            </button>
          </div>
          <div class="pixata-blazor-window-content">
            <form class="pixata-blazor-form" @onsubmit="SaveEdit">
              @if (form?.FormTemplate is not null) {
                @form.FormTemplate(editItem)
              } else {
                <div class="pixata-blazor-form-layout" style="@($"grid-template-columns: repeat({Math.Max(form?.Columns ?? 1, 1)}, minmax(0, 1fr))")">
                  @foreach (PixataGridColumn<TItem> column in PopupColumns) {
                    <div class="pixata-blazor-form-field">
                      <label class="pixata-blazor-form-label">@column.HeaderText</label>
                      <div class="pixata-blazor-form-field-wrap">
                        @if (CanEdit(column)) {
                          @Editor(column, editItem)
                          @if (ValidationMessage(column) is string message) {
                            <div class="pixata-blazor-form-error">@message</div>
                          }
                        } else {
                          <span class="pixata-blazor-form-readonly">@column.CellText(editItem)</span>
                        }
                      </div>
                    </div>
                  }
                </div>
              }
              @Validator
              <button type="submit" hidden></button>
            </form>
          </div>
          <div class="@($"pixata-blazor-window-actions pixata-blazor-window-actions-{buttonsLayout}")">
            @if (form?.ButtonsTemplate is not null) {
              <CascadingValue Value="RowContext(_isNew ? editItem : _originalEditItem!)">
                @form.ButtonsTemplate
              </CascadingValue>
            } else {
              <button type="button" class="pixata-blazor-button pixata-blazor-button-solid pixata-blazor-button-primary" @onclick="SaveEdit">
                @PixataGridIcons.For(PixataGridIcon.Save)
                <span class="pixata-blazor-button-text">@PixataGridMessages.Update</span>
              </button>
              <button type="button" class="pixata-blazor-button pixata-blazor-button-solid" @onclick="CancelEditCommand">
                @PixataGridIcons.For(PixataGridIcon.Cancel)
                <span class="pixata-blazor-button-text">@PixataGridMessages.Cancel</span>
              </button>
            }
          </div>
        </div>
      </div>;
  }

  private Task SaveEdit() =>
    Command("Save", default);

  private Task CancelEditCommand() =>
    Command("Cancel", default);

  private Task PopupKeyDown(KeyboardEventArgs e) =>
    e.Key == "Escape" ? CancelEditCommand() : Task.CompletedTask;

  private static readonly RenderFragment FilterIcon =
    @<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 2h14l-5.5 6.5V14l-3-2V8.5z" /></svg>;

  private static readonly RenderFragment FilterClearIcon =
    @<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 2h12L8.5 7.5V13l-2-1.3V7.5zm9.6 7.4 1.9 1.9 1.9-1.9.7.7-1.9 1.9 1.9 1.9-.7.7-1.9-1.9-1.9 1.9-.7-.7 1.9-1.9-1.9-1.9z" /></svg>;

  private static readonly List<(object?, string)> BooleanItems = [(null, "(All)"), (true, "is true"), (false, "is false")];

  // An editor for a filter value, suited to the column's type. The callback's second argument says whether to wait a moment
  // before filtering, which is only wanted for typing in the filter row
  private RenderFragment Editor(PixataGridColumn<TItem> column, object? value, Func<object?, bool, Task> changed, bool inRow) => column.FilterKind switch {
    FilterKind.Number =>
      @<PixataGridNumericTextBox Value="ToDecimal(value)" ValueChanged="d => changed(FromDecimal(column, d), inRow)" AriaLabel="@($"{column.HeaderText} Filter")" />,
    FilterKind.Date =>
      @<PixataDatePicker TValue="DateTime?" Value="ToDate(value)" ValueChanged="d => changed(FromDate(column, d), false)" Class="pixata-blazor-grid-filter-date" />,
    FilterKind.Boolean =>
      @<PixataGridDropDownList TValue="object" Items="BooleanItems" Value="value" ValueChanged="v => changed(v, false)" AriaLabel="@($"{column.HeaderText} Filter")" Class="pixata-blazor-grid-filter-editor" />,
    FilterKind.Enum =>
      @<PixataGridDropDownList TValue="object" Items="EnumItems(column)" Value="value" DefaultText="-Select value-" ValueChanged="v => changed(v, false)" AriaLabel="@($"{column.HeaderText} Filter")" Class="pixata-blazor-grid-filter-editor" />,
    _ =>
      @<span class="pixata-blazor-grid-textbox">
        <input class="pixata-blazor-grid-input-inner" type="text" value="@(value as string)" aria-label="@($"{column.HeaderText} Filter")" @oninput="e => changed(e.Value?.ToString(), inRow)" />
      </span>
  };

  private static List<(object?, string)> EnumItems(PixataGridColumn<TItem> column) {
    Type type = Nullable.GetUnderlyingType(column.FieldType!) ?? column.FieldType!;
    return [.. Enum.GetValues(type).Cast<object>().Select(v => ((object?)v, v.ToString()!))];
  }

  private RenderFragment FilterCell(PixataGridColumn<TItem> column) {
    if (column.FilterCellTemplate is not null) {
      return column.FilterCellTemplate(TemplateContext(column));
    }
    ColumnFilterState state = RowState(column);
    return
      @<div class="pixata-blazor-grid-filtercell">
        <div class="pixata-blazor-grid-filtercell-wrapper">
          @Editor(column, state.Value1, (v, debounce) => OnFilterRowValueChanged(column, v, debounce), true)
          <div class="pixata-blazor-grid-filtercell-operator">
            @if (column.FilterKind != FilterKind.Boolean) {
              <PixataGridDropDownList TValue="GridFilterOperator"
                                      Icon="FilterIcon"
                                      Items="OperatorsFor(column.FilterKind, column.IsNullable)"
                                      Value="state.Operator1"
                                      ValueChanged="op => OnFilterRowOperatorChanged(column, op)"
                                      AriaLabel="@column.HeaderText"
                                      Class="pixata-blazor-grid-filter-operator" />
            }
            <button type="button"
                    class="pixata-blazor-button pixata-blazor-button-solid pixata-blazor-button-icon pixata-blazor-grid-filter-clear"
                    title="Clear"
                    aria-label="Clear"
                    disabled="@(!HasFilter(column))"
                    @onclick="() => ClearFilterRow(column)">
              @FilterClearIcon
            </button>
          </div>
        </div>
      </div>;
  }

  private RenderFragment FilterMenu(PixataGridColumn<TItem> column) {
    PixataGridFilterTemplateContext? templateContext = column.FilterMenuTemplate is null ? null : TemplateContext(column);
    return
      @<div @ref="_menuPopup" class="pixata-blazor-grid-filter-popup" role="dialog" aria-label="@($"{column.HeaderText} Filter Menu")">
        <div class="pixata-blazor-grid-columnmenu-item">
          @FilterIcon
          Filter
        </div>
        <form class="pixata-blazor-grid-filter-menu" @onsubmit="() => templateContext is null ? ApplyFilterMenu() : templateContext.FilterAsync()">
          <div class="pixata-blazor-grid-filter-menu-container">
            @if (templateContext is not null) {
              @column.FilterMenuTemplate!(templateContext)
            } else if (column.FilterMenuType == PixataGridFilterMenuType.CheckBoxList) {
              List<(object? Value, string Text)> values = DistinctValues(column);
              List<(object? Value, string Text)> shown = [.. values.Where(v => _menuSearch.Length == 0 || v.Text.Contains(_menuSearch, StringComparison.CurrentCultureIgnoreCase))];
              <span class="pixata-blazor-grid-search">
                <span class="pixata-blazor-grid-search-icon">@SearchIcon</span>
                <input class="pixata-blazor-grid-input-inner" type="text" placeholder="Search" value="@_menuSearch" @oninput="e => _menuSearch = e.Value?.ToString() ?? string.Empty" />
              </span>
              <ul class="pixata-blazor-grid-multicheck">
                <li class="pixata-blazor-grid-multicheck-item pixata-blazor-grid-multicheck-all">
                  <label class="pixata-blazor-grid-checkbox-label">
                    <input type="checkbox" class="pixata-blazor-checkbox" checked="@(shown.Count > 0 && shown.All(v => _menuState.Checked.Contains(v.Value)))" @onchange="e => ToggleAll(shown, e)" />
                    <span>Select All</span>
                  </label>
                </li>
                @foreach ((object? value, string text) in shown) {
                  <li class="pixata-blazor-grid-multicheck-item">
                    <label class="pixata-blazor-grid-checkbox-label">
                      <input type="checkbox" class="pixata-blazor-checkbox" checked="@_menuState.Checked.Contains(value)" @onchange="e => ToggleValue(value, e)" />
                      <span>@text</span>
                    </label>
                  </li>
                }
              </ul>
            } else if (column.FilterKind == FilterKind.Boolean) {
              @Editor(column, _menuState.Value1, (v, _) => SetMenuValue(1, v), false)
            } else {
              List<(GridFilterOperator, string)> operators = OperatorsFor(column.FilterKind, column.IsNullable);
              <PixataGridDropDownList TValue="GridFilterOperator" Items="operators" Value="_menuState.Operator1" ValueChanged="op => _menuState.Operator1 = op" AriaLabel="Filter Operators list" Class="pixata-blazor-grid-filter-editor" />
              @Editor(column, _menuState.Value1, (v, _) => SetMenuValue(1, v), false)
              <div class="pixata-blazor-grid-button-group" role="group">
                <button type="button" class="@Css.Join("pixata-blazor-button", "pixata-blazor-button-solid", _menuState.Logic == GridFilterLogic.And ? "pixata-blazor-button-selected" : null)" aria-pressed="@(_menuState.Logic == GridFilterLogic.And ? "true" : "false")" @onclick="() => _menuState.Logic = GridFilterLogic.And">And</button>
                <button type="button" class="@Css.Join("pixata-blazor-button", "pixata-blazor-button-solid", _menuState.Logic == GridFilterLogic.Or ? "pixata-blazor-button-selected" : null)" aria-pressed="@(_menuState.Logic == GridFilterLogic.Or ? "true" : "false")" @onclick="() => _menuState.Logic = GridFilterLogic.Or">Or</button>
              </div>
              <PixataGridDropDownList TValue="GridFilterOperator" Items="operators" Value="_menuState.Operator2" ValueChanged="op => _menuState.Operator2 = op" AriaLabel="Filter Operators list" Class="pixata-blazor-grid-filter-editor" />
              @Editor(column, _menuState.Value2, (v, _) => SetMenuValue(2, v), false)
            }
            <div class="pixata-blazor-grid-filter-actions">
              <button type="submit" class="pixata-blazor-button pixata-blazor-button-solid pixata-blazor-button-primary">
                @FilterIcon
                Filter
              </button>
              <button type="button" class="pixata-blazor-button pixata-blazor-button-solid" @onclick="() => templateContext is null ? ClearFilterMenu() : templateContext.ClearFilterAsync()">
                @FilterClearIcon
                Clear
              </button>
            </div>
          </div>
        </form>
      </div>;
  }

  private static readonly RenderFragment SearchIcon =
    @<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 1a5.5 5.5 0 0 1 4.4 8.8l4 4-.7.7-4-4A5.5 5.5 0 1 1 6.5 1m0 1a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9" /></svg>;

  private Task SetMenuValue(int condition, object? value) {
    object? cleaned = value is string text && text.Length == 0 ? null : value;
    if (condition == 1) {
      _menuState.Value1 = cleaned;
    } else {
      _menuState.Value2 = cleaned;
    }
    return Task.CompletedTask;
  }

  private void ToggleValue(object? value, ChangeEventArgs e) {
    if (e.Value is true) {
      _menuState.Checked.Add(value);
    } else {
      _menuState.Checked.Remove(value);
    }
  }

  private void ToggleAll(List<(object? Value, string Text)> shown, ChangeEventArgs e) {
    foreach ((object? value, _) in shown) {
      if (e.Value is true) {
        _menuState.Checked.Add(value);
      } else {
        _menuState.Checked.Remove(value);
      }
    }
  }
}
