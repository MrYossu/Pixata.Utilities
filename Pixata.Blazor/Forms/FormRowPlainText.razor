<div class="pixata-form-group pixata-row">
  <label for="@PropertyName" class="pixata-col-2 pixata-col-form-label">@(Caption ?? PropertyName)</label>
  <div class="pixata-col-10 pixata-input-group">
    <div class="pixata-input-group-prepend">
      <span class="pixata-input-group-text pixata-h-100">
        <i class="@Icon"></i>
      </span>
    </div>
    <input type="text" disabled="disabled" id="@PropertyName" class="pixata-flex-fill pixata-pl-2" value="@Value"/>
    <div class="pixata-input-group-append">
      <div class="pixata-input-group-text pixata-has-error pixata-h-100">
      </div>
    </div>
  </div>
</div>

@code {

  [Parameter]
  public string PropertyName { get; set; }

  [Parameter]
  public string Value { get; set; }

  [Parameter]
  public EventCallback<string> ValueChanged { get; set; }

  [Parameter]
  public string Caption { get; set; }

  [Parameter]
  public string Icon { get; set; }

  [Parameter]
  public Expression<Func<string>> ValueExpression { get; set; }

  [Parameter]
  public Dictionary<string, object> Attributes { get; set; } = new();

}