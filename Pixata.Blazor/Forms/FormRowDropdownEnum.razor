@typeparam TEnum

<div class="pixata-form-group pixata-row">
  <label for="@PropertyName" class="pixata-col-2 pixata-col-form-label">@(Caption ?? PropertyName)</label>
  <div class="pixata-col-10 pixata-input-group">
    <div class="pixata-input-group-prepend">
      <span class="pixata-input-group-text pixata-h-100">
        <i class="@Icon"></i>
      </span>
    </div>
    <select class="pixata-form-control" name="@PropertyName" id="@PropertyName" @bind="Value">

      @foreach (TEnum enumValue in EnumValues) {
        if (ChildContent == default) {
          <option value="@enumValue">@enumValue.ToString().SplitCamelCase()</option>
        } else {
          @ChildContent(enumValue)
        }
      }
    </select>
  </div>
</div>