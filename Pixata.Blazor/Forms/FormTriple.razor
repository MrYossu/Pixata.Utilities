<div class="pixata-form-triple triple-element pixata-d-flex pixata-flex-wrap pixata-gap-col-3 gap-col-3">
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill pixata-position-relative">
    @if (FirstRequired) {
      <label for="@FirstId" class="pixata-form-label">@FirstLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@FirstId" class="pixata-form-label">@FirstLabel</label>
    }
    @First
  </div>
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill pixata-position-relative">
    @if (SecondRequired) {
      <label for="@SecondId" class="pixata-form-label">@SecondLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@SecondId" class="pixata-form-label">@SecondLabel</label>
    }
    @Second
  </div>
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill pixata-position-relative">
    @if (ThirdRequired) {
      <label for="@ThirdId" class="pixata-form-label">@ThirdLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@ThirdId" class="pixata-form-label">@ThirdLabel</label>
    }
    @Third
  </div>
</div>

@code {
  /// <summary>
  /// Specifies the first element's id to be used in the label for
  /// </summary>
  [Parameter]
  public string FirstId { get; set; } = "";
  /// <summary>
  /// Specifies the second element's id to be used in the label for
  /// </summary>
  [Parameter]
  public string SecondId { get; set; } = "";
  /// <summary>
  /// Specifies the third element's id to be used in the label for
  /// </summary>
  [Parameter]
  public string ThirdId { get; set; } = "";
  /// <summary>
  /// The value of the first label element
  /// </summary>
  [Parameter]
  public string FirstLabel { get; set; } = "";
  /// <summary>
  /// The value of the second label element
  /// </summary>
  [Parameter]
  public string SecondLabel { get; set; } = "";
  /// <summary>
  /// The value of the third label element
  /// </summary>
  [Parameter]
  public string ThirdLabel { get; set; } = "";
  /// <summary>
  /// Specifies if the first element is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool FirstRequired { get; set; }
  /// <summary>
  /// Specifies if the second element is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool SecondRequired { get; set; }
  /// <summary>
  /// Specifies if the third element is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool ThirdRequired { get; set; }
  /// <summary>
  /// Specifies if the element should have the pixata-mt-3 class added (a 1rem top margin)
  /// </summary>
  [Parameter]
  public bool MarginTop { get; set; } = true;
  [Parameter]
  public RenderFragment First { get; set; } = null!;
  [Parameter]
  public RenderFragment Second { get; set; } = null!;
  [Parameter]
  public RenderFragment Third { get; set; } = null!;
}
