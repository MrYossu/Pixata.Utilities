
<div class="pixata-form-group pixata-row">
  <label for="@PropertyName" class="pixata-col-2 pixata-col-form-label">@(Caption ?? PropertyName)</label>
  <div class="pixata-col-10 pixata-input-group">
    <div class="pixata-input-group-prepend pixata-h-100">
      <span class="pixata-input-group-text pixata-h-100" style="display: inline-block">
        <i class="@Icon"></i>
      </span>
    </div>
    <textarea class="pixata-form-control @_invalid" id="@PropertyName" name="@PropertyName" @onchange="@OnChanged" rows="@Rows" @attributes="Attributes">@Value</textarea>
    <div class="pixata-input-group-append pixata-h-100">
      <div class="pixata-input-group-text pixata-has-error pixata-h-100">
        @if (_showValidationMsg) {
          <ValidationMessage For="@ValueExpression" />
        }
      </div>
    </div>
  </div>
</div>

@code {

  [CascadingParameter]
  public EditContext CascadedEditContext { get; set; }

  [Parameter]
  public string PropertyName { get; set; }

  [Parameter]
  public string Value { get; set; }

  [Parameter]
  public EventCallback<string> ValueChanged { get; set; }

  [Parameter]
  public string Caption { get; set; }

  [Parameter]
  public string Icon { get; set; }

  [Parameter]
  public int Rows { get; set; } = 4;

  [Parameter]
  public Expression<Func<string>> ValueExpression { get; set; }

  [Parameter]
  public Dictionary<string, object> Attributes { get; set; } = new();

  private bool _showValidationMsg;
  private string _invalid = "";

  private async Task OnChanged(ChangeEventArgs cea) {
    await ValueChanged.InvokeAsync(cea.Value?.ToString() ?? "");
    FieldIdentifier identifier = CascadedEditContext.Field(PropertyName);
    CascadedEditContext.NotifyFieldChanged(identifier);
  }

  protected override void OnInitialized() {
    CascadedEditContext.OnValidationStateChanged += EditContext_OnValidationStateChanged;
    base.OnInitialized();
  }

  private void EditContext_OnValidationStateChanged(object sender, ValidationStateChangedEventArgs e) {
    FieldIdentifier identifier = CascadedEditContext.Field(PropertyName);
    _showValidationMsg = CascadedEditContext.GetValidationMessages(identifier).Any();
    _invalid = _showValidationMsg ? "pixata-invalid" : "";
  }

}