@if (IsContainer) {
  <div class="pixata-d-flex pixata-form-container">
    <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill pixata-position-relative">
      @if (Required) {
        <label for="@Id" class="pixata-form-label pixata-w-100">@Label <span class="pixata-text-danger">*</span></label>
      } else {
        <label for="@Id" class="pixata-form-label pixata-w-100">@Label</label>
      }
      @ChildContent
    </div>
  </div>
} else {
  <div class="pixata-mt-3 pixata-position-relative">
    @if (Required) {
      <label for="@Id" class="pixata-form-label">@Label <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@Id" class="pixata-form-label">@Label</label>
    }
    @ChildContent
  </div>
}

@code {
  /// <summary>
  /// Specifies the id to be used in the label for
  /// </summary>
  [Parameter]
  public string Id { get; set; } = "";
  /// <summary>
  /// The value of the label element
  /// </summary>
  [Parameter]
  public string Label { get; set; } = "";
  /// <summary>
  /// If the element should not exceed 50% of larger size windows then set this to true. Below a container width of 430px, it takes the full width.
  /// See <see href="https://mryossu.atlassian.net/wiki/spaces/SA/pages/21594114/Form+components#IsContainer">wiki for more info</see>
  /// </summary>
  [Parameter]
  public bool IsContainer { get; set; }
  /// <summary>
  /// Specifies if the content is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool Required { get; set; }
  /// <summary>
  /// Specifies if the element should have the pixata-mt-3 class added (a 1rem top margin)
  /// </summary>
  [Parameter]
  public bool MarginTop { get; set; } = true;
  [Parameter]
  public RenderFragment ChildContent { get; set; } = null!;
}
