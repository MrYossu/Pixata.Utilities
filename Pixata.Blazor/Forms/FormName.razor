<div class="pixata-form-name pixata-d-flex pixata-flex-wrap pixata-gap-col-3 gap-col-3">
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill pixata-form-name-title">
    @if (TitleRequired) {
      <label for="@TitleId" class="pixata-form-label">@TitleLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@TitleId" class="pixata-form-label">@TitleLabel</label>
    }
    @Title
  </div>
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill">
    @if (SalutationRequired) {
      <label for="@SalutationId" class="pixata-form-label">@SalutationLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@SalutationId" class="pixata-form-label">@SalutationLabel</label>
    }
    @Salutation
  </div>
  <div class="@(MarginTop ? "pixata-mt-3 " : "")pixata-flex-fill">
    @if (SurnameRequired) {
      <label for="@SurnameId" class="pixata-form-label">@SurnameLabel <span class="pixata-text-danger">*</span></label>
    } else {
      <label for="@SurnameId" class="pixata-form-label">@SurnameLabel</label>
    }
    @Surname
  </div>
</div>

@code {
  /// <summary>
  /// Specifies the title id to be used in the label for
  /// </summary>
  [Parameter]
  public string TitleId { get; set; } = "";
  /// <summary>
  /// Specifies the salutation id to be used in the label for
  /// </summary>
  [Parameter]
  public string SalutationId { get; set; } = "";
  /// <summary>
  /// Specifies the surname id to be used in the label for
  /// </summary>
  [Parameter]
  public string SurnameId { get; set; } = "";
  /// <summary>
  /// The value of the title label element
  /// </summary>
  [Parameter]
  public string TitleLabel { get; set; } = "";
  /// <summary>
  /// The value of the salutation label element
  /// </summary>
  [Parameter]
  public string SalutationLabel { get; set; } = "";
  /// <summary>
  /// The value of the surname label element
  /// </summary>
  [Parameter]
  public string SurnameLabel { get; set; } = "";
  /// <summary>
  /// Specifies if the title is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool TitleRequired { get; set; }
  /// <summary>
  /// Specifies if the salutation is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool SalutationRequired { get; set; }
  /// <summary>
  /// Specifies if the surname is required (adds a red * after the label)
  /// </summary>
  [Parameter]
  public bool SurnameRequired { get; set; }
  /// <summary>
  /// Specifies if the element should have the pixata-mt-3 class added (a 1rem top margin)
  /// </summary>
  [Parameter]
  public bool MarginTop { get; set; } = true;
  [Parameter]
  public RenderFragment Title { get; set; } = null!;
  [Parameter]
  public RenderFragment Salutation { get; set; } = null!;
  [Parameter]
  public RenderFragment Surname { get; set; } = null!;
}
