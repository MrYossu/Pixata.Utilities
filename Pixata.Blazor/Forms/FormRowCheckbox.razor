@using Pixata.Blazor.Components
<div class="pixata-form-group pixata-row">
  <label for="@PropertyName" class="pixata-col-2 pixata-col-form-label">@(Caption ?? PropertyName)</label>
  <div class="pixata-col-10 pixata-input-group">
    <div class="pixata-input-group-prepend">
      <span class="pixata-input-group-text pixata-h-100">
        <i class="@Icon"></i>
      </span>
    </div>
    <PixataCheckBox TValue="bool" Id="@PropertyName" Value="@Checked" ValueChanged="@OnChanged" Class="@Class" />
  </div>
</div>

@code {

  [Parameter]
  public string PropertyName { get; set; } = null!;

  [Parameter]
  public bool Checked { get; set; }

  [Parameter]
  public EventCallback<bool> CheckedChanged { get; set; }

  [Parameter]
  public string? Caption { get; set; }

  [Parameter]
  public string? Text { get; set; }

  [Parameter]
  public string? Icon { get; set; }

  [Parameter]
  public string? Class { get; set; }

  private async Task OnChanged(bool value) =>
    await CheckedChanged.InvokeAsync(value);

}