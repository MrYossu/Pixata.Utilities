@using Pixata.Blazor.Components

<div class="dd-item pixata-position-relative">
  <div class="pixata-d-flex pixata-gap-3" @onclick="OpenFromNotification">
    <div class="notif-icon d-grid-center @NotificationHelper.GetColourClass(Type)">
      <PixataIcon Icon="@NotificationHelper.GetDisplayIcon(Type)" Class="@(Type == NotificationType.General ? "tilt" : null)" />
    </div>
    <div class="message">
      @if (Content is not null) {
        <div>@Content</div>
      } else {
        <div>@Message</div>
      }
      <small class="time">@Time.ToPrettyString(true)</small>
    </div>
  </div>
  <div class="dismiss" @onclick="@DismissIt"><button class="pixata-btn pixata-btn-close" aria-label="Dismiss" /></div>
</div>

@code {
  [Parameter]
  public string Message { get; set; } = "";
  /// <summary>
  /// Shown instead of <see cref="Message"/> when set, for a message with formatting, such as a list
  /// </summary>
  [Parameter]
  public RenderFragment? Content { get; set; }
  [Parameter]
  public DateTime Time { get; set; } = DateTime.Now;
  [Parameter]
  public NotificationType Type { get; set; }
  [Parameter]
  public EventCallback Dismiss { get; set; }
  [Parameter]
  public EventCallback Open { get; set; }

  private Task OpenFromNotification() =>
    Open.InvokeAsync();

  private Task DismissIt() =>
    Dismiss.InvokeAsync();
}
