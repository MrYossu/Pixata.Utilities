@namespace Pixata.Blazor.Auditing.Components

<div class="pixata-blazor-audit-property-row @(IsChanged ? "pixata-blazor-audit-property-changed" : "")">
  <span class="pixata-blazor-audit-property-name">@PropertyName</span>
  @if (IsChanged) {
    <span class="pixata-blazor-audit-property-badge">🟡</span>
    <div class="pixata-blazor-audit-property-values">
      <span class="pixata-blazor-audit-old-value">@OldValue</span>
      <span class="pixata-blazor-audit-arrow">→</span>
      <span class="pixata-blazor-audit-new-value">@NewValue</span>
    </div>
  } else {
    <span class="pixata-blazor-audit-property-value">@Value</span>
  }
</div>

@code {
  [Parameter]
  public string PropertyName { get; set; } = "";

  [Parameter]
  public string? Value { get; set; }

  [Parameter]
  public bool IsChanged { get; set; }

  [Parameter]
  public string? OldValue { get; set; }

  [Parameter]
  public string? NewValue { get; set; }
}
