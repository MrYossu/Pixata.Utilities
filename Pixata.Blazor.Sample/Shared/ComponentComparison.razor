@*
  Shows a Pixata component next to its Telerik equivalent, so the two can be compared. The columns sit side by side on wide
  screens and stack on narrow ones
*@
<section class="component-comparison">
  @if (!string.IsNullOrWhiteSpace(Title)) {
    <h4>@Title</h4>
  }
  @if (Description is not null) {
    <div class="component-comparison-description">@Description</div>
  }
  <div class="component-comparison-columns">
    <div class="component-comparison-column">
      <h5>Pixata</h5>
      @Pixata
    </div>
    <div class="component-comparison-column">
      <h5>Telerik</h5>
      @Telerik
    </div>
  </div>
</section>

@code {

  [Parameter]
  public string? Title { get; set; }

  [Parameter]
  public RenderFragment? Description { get; set; }

  [Parameter]
  public RenderFragment? Pixata { get; set; }

  [Parameter]
  public RenderFragment? Telerik { get; set; }

}
