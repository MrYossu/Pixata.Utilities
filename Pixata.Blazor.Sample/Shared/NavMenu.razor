@implements IDisposable
@inject NavigationManager Navigation

<div class="top-row ps-4 navbar navbar-dark">
  <a class="navbar-brand" href="">Pixata.Blazor.Sample</a>
  <button class="navbar-toggler" @onclick="ToggleNavMenu">
    <span class="navbar-toggler-icon"></span>
  </button>
</div>

@* Open Iconic icons can be seen at https://icones.js.org/collection/oi *@
<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
  <ul class="nav flex-column">
    <li class="nav-item px-3">
      <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
        <span class="oi oi-home" aria-hidden="true"></span> Home
      </NavLink>
    </li>
    @foreach (NavSection section in Sections) {
      bool open = _open.Contains(section.Title);
      <li class="nav-section px-3">
        <button type="button"
                class="nav-section-toggle"
                aria-expanded="@(open ? "true" : "false")"
                @onclick="() => ToggleSection(section)"
                @onclick:stopPropagation="true">
          <span class="@section.Icon" aria-hidden="true"></span>
          <span class="nav-section-title">@section.Title</span>
          <span class="nav-section-arrow @(open ? "nav-section-arrow-open" : null)" aria-hidden="true"></span>
        </button>
        @if (open) {
          <ul class="nav flex-column nav-section-items">
            @foreach (NavItem item in section.Items) {
              <li class="nav-item">
                <NavLink class="nav-link text-truncate" href="@item.Href" Match="NavLinkMatch.All">
                  <span class="@item.Icon" aria-hidden="true"></span> @item.Title
                </NavLink>
              </li>
            }
          </ul>
        }
      </li>
    }
  </ul>
</div>

@code {
  private record NavItem(string Href, string Title, string Icon);

  private record NavSection(string Title, string Icon, List<NavItem> Items);

  // Every sample page, grouped by what it shows. Add new pages here
  private static readonly List<NavSection> Sections = [
    new("Grids and data", "far fa-border-all", [
      new("pixata-grid", "Pixata grid", "far fa-border-all"),
      new("VirtualiseWithState", "Virtualise with state", "far fa-stream"),
      new("ChartSample", "Chart", "far fa-chart-bar"),
      new("SchedulerSample", "Scheduler", "far fa-calendar-week"),
      new("AuditViewerSample", "Audit viewer", "oi oi-list")
    ]),
    new("Dates", "far fa-calendar-alt", [
      new("pixata-datepicker", "Pixata date picker", "far fa-calendar-alt"),
      new("hebrewdatepicker", "Hebrew date picker", "far fa-calendar-alt")
    ]),
    new("Forms and inputs", "far fa-edit", [
      new("FormSample", "Forms", "oi oi-data-transfer-download"),
      new("DropDownsSample", "Drop-downs", "far fa-caret-square-down"),
      new("RadioGroupSample", "Radio group", "far fa-dot-circle"),
      new("SwitchSample", "Switch", "fas fa-toggle-on"),
      new("EditorSample", "Editor", "far fa-edit"),
      new("FileUploadSample", "File select and upload", "fas fa-upload")
    ]),
    new("Layout", "far fa-window-maximize", [
      new("TabStripSample", "Tab strip", "far fa-folder"),
      new("WindowSample", "Window", "far fa-window-maximize"),
      new("WizardSample", "Wizard and stepper", "fas fa-magic"),
      new("ExpanderSample", "Expander", "fal fa-expand-arrows-alt"),
      new("ButtonsSample", "Drop-down and split buttons", "far fa-caret-square-down")
    ]),
    new("Messages", "far fa-comment-alt", [
      new("DialogsSample", "Dialogs", "far fa-comment-alt"),
      new("Notifications", "Notifications", "oi oi-info"),
      new("InformSample", "Inform", "oi oi-warning"),
      new("ConfirmSample", "Confirm", "far fa-check-circle"),
      new("LoaderSample", "Loader", "fas fa-truck-loading")
    ]),
    new("Helpers", "fas fa-tools", [
      new("Conditionals", "Conditionals", "fas fa-question"),
      new("ConditionalSample", "Conditional", "fas fa-question"),
      new("ApiResponseViewRegular", "ApiResponseView 1", "fas fa-reply"),
      new("ApiResponseViewManual", "ApiResponseView 2", "fas fa-reply-all"),
      new("SendEmail", "Email", "far fa-at")
    ]),
    // Pages for the packages that use Telerik UI for Blazor
    new("Telerik", "fas fa-puzzle-piece", [
      new("TelerikGrid", "Telerik grid", "far fa-border-all"),
      new("TelerikGridWithState", "Telerik grid with state", "far fa-border-all"),
      new("telerikhebrewdatepicker", "Telerik Hebrew date picker", "far fa-calendar-alt"),
      new("TelerikFormRows", "Telerik form rows", "far fa-edit")
    ])
  ];

  private readonly System.Collections.Generic.HashSet<string> _open = [];
  private bool collapseNavMenu = true;

  private string? NavMenuCssClass =>
    collapseNavMenu ? "collapse" : null;

  protected override void OnInitialized() {
    OpenCurrentSection();
    Navigation.LocationChanged += LocationChanged;
  }

  // The section with the page being shown is opened, so the page is always visible in the menu
  private void OpenCurrentSection() {
    string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
    NavSection? current = Sections.FirstOrDefault(s => s.Items.Any(i => string.Equals(i.Href, path, StringComparison.OrdinalIgnoreCase)));
    if (current is not null) {
      _open.Add(current.Title);
    }
  }

  private void LocationChanged(object? sender, LocationChangedEventArgs e) {
    OpenCurrentSection();
    InvokeAsync(StateHasChanged);
  }

  private void ToggleSection(NavSection section) {
    if (!_open.Remove(section.Title)) {
      _open.Add(section.Title);
    }
  }

  private void ToggleNavMenu() =>
    collapseNavMenu = !collapseNavMenu;

  public void Dispose() =>
    Navigation.LocationChanged -= LocationChanged;
}
