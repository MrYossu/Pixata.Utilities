@page "/DropDownsSample"
@using Pixata.Blazor.Sample.Models
@using static Pixata.Blazor.Sample.Models.DropDownSampleData

<SitePageTitle>Drop-downs</SitePageTitle>

<h3>Drop-downs</h3>

<p>
  <code>PixataDropDownList</code>, <code>PixataComboBox</code> and <code>PixataMultiSelect</code>. See <a href="https://github.com/MrYossu/Pixata.Utilities/blob/master/Pixata.Blazor/Readme.DropDowns.md">the documentation</a>.
</p>

<h4 class="mt-4">Drop-down list</h4>

<ComponentSample Title="Primitive data">
  <Description>A list of strings, with <code>DefaultText</code>. Tab to it and use the arrow keys, Home/End or type a letter, or press Alt+Down to open it.</Description>
  <ChildContent>
    <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" DefaultText="Choose a fruit..." Width="250px" Id="pixata-ddl-fruit" />
    <p class="mt-2"><small>Value: @(_fruit ?? "(null)")</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Model data, filtering and grouping">
  <Description><code>TextField</code>, <code>ValueField</code> and <code>GroupField</code>, with <code>Filterable</code> and <code>FilterOperator="Contains"</code>.</Description>
  <ChildContent>
    <PixataDropDownList Data="@Countries" TextField="Name" ValueField="Id" GroupField="Continent" @bind-Value="@_countryId" Filterable="true" FilterOperator="PixataStringFilterOperator.Contains" Width="250px" Id="pixata-ddl-country" />
    <p class="mt-2"><small>Value: @_countryId</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Templates">
  <Description>Item, value, header, footer and no-data templates.</Description>
  <ChildContent>
    <PixataDropDownList Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_templatedId" Filterable="true" Width="250px" Id="pixata-ddl-templates">
      <ItemTemplate><strong>@context.Name</strong>&nbsp;<small>(@context.Continent)</small></ItemTemplate>
      <ValueTemplate>@context.Name, @context.Continent</ValueTemplate>
      <HeaderTemplate><div style="padding: 4px 8px; font-weight: bold;">Countries</div></HeaderTemplate>
      <FooterTemplate><div style="padding: 4px 8px;">@Countries.Count countries</div></FooterTemplate>
      <NoDataTemplate>No country matches that</NoDataTemplate>
    </PixataDropDownList>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Sizes, fill modes and states">
  <Description><code>Size</code>, <code>FillMode</code>, <code>Rounded</code>, <code>Enabled</code> and <code>ReadOnly</code>. The Pixata one also has <code>ShowClearButton</code>.</Description>
  <ChildContent>
    <div style="display: grid; gap: 8px; max-width: 250px;">
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" Size="sm" DefaultText="Small" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" Size="lg" DefaultText="Large" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" FillMode="outline" DefaultText="Outline" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" FillMode="flat" DefaultText="Flat" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" Rounded="full" DefaultText="Rounded full" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" Enabled="false" DefaultText="Disabled" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" ReadOnly="true" DefaultText="Read-only" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_fruit" ShowClearButton="true" DefaultText="Clear button" />
    </div>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Icon-only">
  <Description>
    With <code>Icon</code> (or <code>IconTemplate</code>), the drop-down list is a small square showing just the icon, for
    where there isn't room for the selected item's text. The list opens as normal, and the selected item is the box's
    tooltip and accessible name (hover over one to see it). The first is a filter like the ones in a grid's filter row, which
    has to fit in a narrow column. Its <code>IconTemplate</code> shows which operator is selected.
  </Description>
  <ChildContent>
    <div style="display: flex; gap: 4px; align-items: center; width: 230px;">
      <span class="pixata-blazor-input pixata-blazor-input-md pixata-blazor-rounded-md pixata-blazor-input-solid">
        <input type="number" class="pixata-blazor-input-inner" @bind="_iconAmount" placeholder="Amount" aria-label="Amount" />
      </span>
      <PixataDropDownList Data="@AmountOperators" @bind-Value="@_iconOperator" AriaLabel="Operator">
        <IconTemplate><strong>@(_iconOperator == "Greater than" ? ">" : "<")</strong></IconTemplate>
      </PixataDropDownList>
      <button type="button" class="pixata-blazor-button pixata-blazor-button-md pixata-blazor-rounded-md pixata-blazor-button-solid pixata-blazor-button-base pixata-blazor-icon-button" title="Clear" @onclick="() => _iconAmount = null">
        <PixataIcon Icon="PixataSvgIcons.X" />
      </button>
    </div>
    <p class="mt-2"><small>@(_iconAmount is null ? "No filter" : $"{_iconOperator} {_iconAmount}")</small></p>
    <div style="display: flex; gap: 8px; align-items: center;">
      <PixataDropDownList Data="@Fruit" @bind-Value="@_iconFruit" Icon="PixataSvgIcons.MoreVertical" AriaLabel="Fruit" Size="sm" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_iconFruit" Icon="PixataSvgIcons.MoreVertical" AriaLabel="Fruit" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_iconFruit" Icon="@("fas fa-apple-alt")" AriaLabel="Fruit" Size="lg" />
      <PixataDropDownList Data="@Fruit" @bind-Value="@_iconFruit" Icon="@("fas fa-apple-alt")" AriaLabel="Fruit" FillMode="flat" Filterable="true" />
      <small>Value: @(_iconFruit ?? "(null)")</small>
    </div>
  </ChildContent>
</ComponentSample>

<h4 class="mt-4">Combo box</h4>

<ComponentSample Title="Primitive data">
  <Description>Type to jump to a matching item, or pick one from the list. Enter or leaving the box keeps the item whose text was typed, or clears the value if there isn't one.</Description>
  <ChildContent>
    <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" Placeholder="Choose a fruit..." Width="250px" Id="pixata-combo-fruit" />
    <p class="mt-2"><small>Value: @(_comboFruit ?? "(null)")</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Model data, filtering and grouping">
  <Description><code>Filterable</code> with <code>FilterOperator="Contains"</code>, so typing filters the list.</Description>
  <ChildContent>
    <PixataComboBox Data="@Countries" TextField="Name" ValueField="Id" GroupField="Continent" @bind-Value="@_comboCountryId" Filterable="true" FilterOperator="PixataStringFilterOperator.Contains" Placeholder="Choose a country..." Width="250px" Id="pixata-combo-country" />
    <p class="mt-2"><small>Value: @_comboCountryId</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Custom values">
  <Description><code>AllowCustom</code> lets the user type a fruit that isn't in the list.</Description>
  <ChildContent>
    <PixataComboBox Data="@Fruit" @bind-Value="@_customFruit" AllowCustom="true" Placeholder="Any fruit..." Width="250px" Id="pixata-combo-custom" />
    <p class="mt-2"><small>Value: @(_customFruit ?? "(null)")</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Sizes and states">
  <Description><code>Size</code>, <code>FillMode</code>, <code>Enabled</code>, <code>ReadOnly</code> and <code>ShowClearButton="false"</code>.</Description>
  <ChildContent>
    <div style="display: grid; gap: 8px; max-width: 250px;">
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" Size="sm" Placeholder="Small" />
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" Size="lg" Placeholder="Large" />
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" FillMode="outline" Placeholder="Outline" />
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" Enabled="false" Placeholder="Disabled" />
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" ReadOnly="true" Placeholder="Read-only" />
      <PixataComboBox Data="@Fruit" @bind-Value="@_comboFruit" ShowClearButton="false" Placeholder="No clear button" />
    </div>
  </ChildContent>
</ComponentSample>

<h4 class="mt-4">Multi-select</h4>

<ComponentSample Title="Model data with filtering">
  <Description>Pick items from the list, remove them with their &times; or Backspace.</Description>
  <ChildContent>
    <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_countryIds" Filterable="true" Placeholder="Choose countries..." Width="100%" Id="pixata-ms-countries" />
    <p class="mt-2"><small>Value: @string.Join(", ", _countryIds)</small></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Checkboxes, select all and staying open">
  <Description><code>AutoClose="false"</code> keeps the list open while several items are chosen. <code>EnableCheckBoxes</code> and <code>EnableSelectAll</code> add the checkboxes.</Description>
  <ChildContent>
    <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" GroupField="Continent" @bind-Value="@_checkedIds" AutoClose="false" EnableCheckBoxes="true" EnableSelectAll="true" Filterable="true" FilterOperator="PixataStringFilterOperator.Contains" Placeholder="Choose countries..." Width="100%" Id="pixata-ms-checkboxes" />
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Summary tags">
  <Description><code>MaxAllowedTags="2"</code> shows two tags and counts the rest; <code>TagMode="Single"</code> shows one tag for everything.</Description>
  <ChildContent>
    <div style="display: grid; gap: 8px;">
      <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_summaryIds" MaxAllowedTags="2" Width="100%" />
      <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_summaryIds" TagMode="PixataMultiSelectTagMode.Single" Width="100%" />
    </div>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Custom values and a minimum length">
  <Description>The first allows custom fruit (type one and press Enter). The second only opens once two characters have been typed (<code>MinLength="2"</code>), and has an arrow button.</Description>
  <ChildContent>
    <div style="display: grid; gap: 8px;">
      <PixataMultiSelect Data="@Fruit" @bind-Value="@_customFruits" AllowCustom="true" Placeholder="Any fruit..." Width="100%" Id="pixata-ms-custom" />
      <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_minLengthIds" Filterable="true" MinLength="2" ShowArrowButton="true" Placeholder="Type two letters..." Width="100%" Id="pixata-ms-minlength" />
    </div>
  </ChildContent>
</ComponentSample>

<h4 class="mt-4">Lots of data</h4>

<ComponentSample Title="Virtual scrolling">
  <Description>5,000 products, with <code>ScrollMode="Virtual"</code>, so only the rows that can be seen are rendered.</Description>
  <ChildContent>
    <div style="display: grid; gap: 8px;">
      <PixataDropDownList Data="@Products" TextField="Name" ValueField="Id" @bind-Value="@_productId" ScrollMode="PixataDropDownScrollMode.Virtual" Filterable="true" DefaultText="Choose a product..." Width="100%" Id="pixata-ddl-virtual" />
      <PixataMultiSelect Data="@Products" TextField="Name" ValueField="Id" @bind-Value="@_productIds" ScrollMode="PixataDropDownScrollMode.Virtual" Filterable="true" AutoClose="false" Placeholder="Choose products..." Width="100%" Id="pixata-ms-virtual" />
    </div>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Reading the data from the server">
  <Description><code>OnRead</code> with virtual scrolling, so the data is read a page at a time as the list scrolls, and again (after a pause) when the user types. Each read takes half a second, to show the loading indicator. <code>ValueMapper</code> finds the selected product when it hasn't been read yet.</Description>
  <ChildContent>
    <PixataComboBox TItem="Product" TValue="int" TextField="Name" ValueField="Id" @bind-Value="@_serverProductId" OnRead="@ReadProducts" ValueMapper="@MapProduct" ScrollMode="PixataDropDownScrollMode.Virtual" Filterable="true" FilterOperator="PixataStringFilterOperator.Contains" Placeholder="Search products..." Width="100%" Id="pixata-combo-server" />
    <p class="mt-2"><small>Value: @_serverProductId. @_lastRead</small></p>
  </ChildContent>
</ComponentSample>

<h4 class="mt-4">Forms and events</h4>

<ComponentSample Title="Validation">
  <Description>In an <code>EditForm</code> with data annotations. Press Save without choosing anything to see the invalid state.</Description>
  <ChildContent>
    <EditForm Model="@_pixataForm" OnValidSubmit="@(() => _pixataSaved = true)">
      <DataAnnotationsValidator />
      <div class="mb-2">
        <label id="pixata-form-fruit-label" class="form-label">Fruit</label>
        <PixataDropDownList Data="@Fruit" @bind-Value="@_pixataForm.Fruit" DefaultText="Choose a fruit..." AriaLabelledBy="pixata-form-fruit-label" Width="100%" />
        <ValidationMessage For="@(() => _pixataForm.Fruit)" />
      </div>
      <div class="mb-2">
        <label for="pixata-form-country" class="form-label">Country</label>
        <PixataComboBox Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_pixataForm.CountryId" Id="pixata-form-country" Width="100%" />
        <ValidationMessage For="@(() => _pixataForm.CountryId)" />
      </div>
      <div class="mb-2">
        <label for="pixata-form-countries" class="form-label">Countries visited</label>
        <PixataMultiSelect Data="@Countries" TextField="Name" ValueField="Id" @bind-Value="@_pixataForm.CountryIds" Id="pixata-form-countries" Width="100%" />
        <ValidationMessage For="@(() => _pixataForm.CountryIds)" />
      </div>
      <button type="submit" class="btn btn-primary btn-sm" id="pixata-form-save">Save</button>
      @if (_pixataSaved) {
        <span class="ms-2">Saved</span>
      }
    </EditForm>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Events and methods">
  <Description><code>OnOpen</code>, <code>OnClose</code>, <code>OnChange</code>, <code>OnBlur</code> and <code>ValueChanged</code>, plus the <code>Open()</code> and <code>FocusAsync()</code> methods.</Description>
  <ChildContent>
    <PixataDropDownList @ref="_pixataEvents" Data="@Fruit" Value="@_eventFruit" ValueChanged="@((string v) => { _eventFruit = v; Log(_pixataLog, $"ValueChanged: {v}"); })" DefaultText="Choose a fruit..." Width="250px"
                        OnOpen="@(() => Log(_pixataLog, "OnOpen"))" OnClose="@(() => Log(_pixataLog, "OnClose"))" OnChange="@((object v) => Log(_pixataLog, $"OnChange: {v}"))" OnBlur="@(() => Log(_pixataLog, "OnBlur"))" />
    <div class="mt-2">
      <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _pixataEvents.Open())">Open()</button>
      <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => _pixataEvents.FocusAsync())">FocusAsync()</button>
    </div>
    <pre class="mt-2 small" style="max-height: 10rem; overflow: auto;">@string.Join("\n", _pixataLog)</pre>
  </ChildContent>
</ComponentSample>

@code {

  private string? _fruit;
  private string? _iconFruit = "Banana";
  private decimal? _iconAmount;
  private string _iconOperator = "Less than";
  private static readonly List<string> AmountOperators = ["Less than", "Greater than"];
  private int _countryId = 16;
  private int _templatedId = 8;

  private string? _comboFruit;
  private int _comboCountryId = 11;
  private string? _customFruit;

  private List<int> _countryIds = [11, 16];
  private List<int> _checkedIds = [];
  private List<int> _summaryIds = [1, 7, 11, 17];
  private List<string> _customFruits = ["Apple"];
  private List<int> _minLengthIds = [];

  private int _productId;
  private List<int> _productIds = [];
  private int _serverProductId = 4321;
  private string _lastRead = "";

  private readonly FormModel _pixataForm = new();
  private bool _pixataSaved;

  private PixataDropDownList<string, string> _pixataEvents = null!;
  private string? _eventFruit;
  private readonly List<string> _pixataLog = [];

  private async Task ReadProducts(PixataDropDownReadEventArgs args) {
    // Pretend this is a call to the server
    await Task.Delay(500);
    List<Product> matches = Products.Where(p => args.FilterOperator.Matches(p.Name, args.Filter)).ToList();
    args.Data = args.Take > 0 ? matches.Skip(args.Skip).Take(args.Take).ToList() : matches;
    args.Total = matches.Count;
    _lastRead = $"Last read: filter \"{args.Filter}\", skip {args.Skip}, take {args.Take}, {matches.Count} matches.";
  }

  private Task<Product> MapProduct(int id) =>
    Task.FromResult(Products.FirstOrDefault(p => p.Id == id)!);

  private void Log(List<string> log, string message) {
    log.Insert(0, $"{DateTime.Now:HH:mm:ss} {message}");
    if (log.Count > 20) {
      log.RemoveAt(log.Count - 1);
    }
  }

}
