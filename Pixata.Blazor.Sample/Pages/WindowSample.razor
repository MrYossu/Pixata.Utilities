@page "/WindowSample"
@using Pixata.Blazor.Components

<SitePageTitle>Window</SitePageTitle>

<h3>Window</h3>

<p>
  <code>PixataWindow</code>. See
  <a href="https://github.com/MrYossu/Pixata.Utilities/blob/master/Pixata.Blazor/Readme.Window.md">the documentation</a>.
  Drag a window by its titlebar and resize it by its edges and corners, with a mouse or a finger. When the window itself has
  the focus (click its titlebar, or Tab to it), the arrow keys move it, Ctrl and the arrow keys resize it, Alt+Up and Alt+Down
  maximise, minimise and restore it, and Esc closes it.
</p>

<ComponentSample Title="A window with actions and a footer">
  <Description>
    Non-modal, with the built-in Minimize, Maximize and Close actions, and two-way binding of <code>Visible</code>,
    <code>State</code>, <code>Top</code>, <code>Left</code>, <code>Width</code> and <code>Height</code>, so you can see them
    change as you move and resize it.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => _basicPixata = !_basicPixata">Toggle the window</button>
    <PixataWindow @bind-Visible="_basicPixata"
                  @bind-State="_basicPixataState"
                  @bind-Top="_basicPixataTop"
                  @bind-Left="_basicPixataLeft"
                  @bind-Width="_basicPixataWidth"
                  @bind-Height="_basicPixataHeight">
      <WindowTitle>Customer details</WindowTitle>
      <WindowActions>
        <PixataWindowAction Name="Minimize" />
        <PixataWindowAction Name="Maximize" />
        <PixataWindowAction Name="Close" />
      </WindowActions>
      <WindowContent>
        <p><strong>Fred Bloggs</strong></p>
        <p>12 High Street, Anytown</p>
        <p>Customer since 2019. 14 orders, the last one three weeks ago.</p>
      </WindowContent>
      <WindowFooter>
        <button type="button" class="@BaseButton" @onclick="() => _basicPixata = false">Close</button>
        <button type="button" class="@PrimaryButton" @onclick="() => _basicPixata = false">Save</button>
      </WindowFooter>
    </PixataWindow>
    <p class="window-sample-result">
      Visible: @_basicPixata, State: @_basicPixataState<br />
      Top: @_basicPixataTop, Left: @_basicPixataLeft, Width: @_basicPixataWidth, Height: @(_basicPixataHeight ?? "(auto)")
    </p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="A modal window">
  <Description>
    <code>Modal="true"</code> dims the page and keeps the focus inside the window, and <code>CloseOnOverlayClick="true"</code>
    closes it when you click the overlay. It has no <code>Top</code> or <code>Left</code>, so it opens in the middle of the
    screen, and isn't resizable.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => _modalPixata = true">Open the modal window</button>
    <PixataWindow @bind-Visible="_modalPixata" Modal="true" CloseOnOverlayClick="true" Resizable="false" Width="400px">
      <WindowTitle>Change password</WindowTitle>
      <WindowActions>
        <PixataWindowAction Name="Close" />
      </WindowActions>
      <WindowContent>
        <p><label>Current password<br /><input type="password" /></label></p>
        <p><label>New password<br /><input type="password" /></label></p>
      </WindowContent>
      <WindowFooter>
        <button type="button" class="@PrimaryButton" @onclick="() => _modalPixata = false">Change</button>
      </WindowFooter>
    </PixataWindow>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Several windows">
  <Description>
    Three windows open at once. Click (or tap, or Tab into) one to bring it to the front.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => ShowSeveral(true)">Open three windows</button>
    @for (int i = 0; i < Notes.Length; i++) {
      int index = i;
      <PixataWindow Visible="_severalPixata[index]" VisibleChanged="v => _severalPixata[index] = v" Top="@($"{140 + index * 60}px")" Left="@($"{280 + index * 80}px")" Width="260px">
        <WindowTitle>@Notes[index].Title</WindowTitle>
        <WindowActions>
          <PixataWindowAction Name="Close" />
        </WindowActions>
        <WindowContent>@Notes[index].Text</WindowContent>
      </PixataWindow>
    }
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Keeping a window inside an element">
  <Description>
    <code>ContainmentSelector</code> keeps the window inside the grey box: it can't be dragged out of it, <code>Top</code> and
    <code>Left</code> are measured from it, and maximising the window fills the box rather than the screen.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => _containedPixata = !_containedPixata">Toggle the window</button>
    <div id="pixata-workspace" class="window-sample-workspace">
      <PixataWindow @bind-Visible="_containedPixata" ContainmentSelector="#pixata-workspace" Top="20px" Left="20px" Width="240px">
        <WindowTitle>Contained</WindowTitle>
        <WindowActions>
          <PixataWindowAction Name="Maximize" />
          <PixataWindowAction Name="Close" />
        </WindowActions>
        <WindowContent>Try dragging me out of the box.</WindowContent>
      </PixataWindow>
    </div>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Custom actions, size limits and methods">
  <Description>
    A custom titlebar action (the refresh button), <code>MinWidth</code>, <code>MaxWidth</code>, <code>MinHeight</code> and
    <code>MaxHeight</code> limiting the resizing, <code>PersistContent</code> keeping the text box's contents while minimised,
    and buttons that minimise, maximise and restore the window. The buttons call its <code>Minimize()</code>,
    <code>Maximize()</code> and <code>Restore()</code> methods (setting <code>State</code> works too). The window also has
    a <code>ThemeColor</code>.
  </Description>
  <ChildContent>
    <div class="window-sample-buttons">
      <button type="button" class="@BaseButton" @onclick="() => _customPixata = true">Open</button>
      <button type="button" class="@BaseButton" @onclick="() => _customPixataWindow.Minimize()">Minimize()</button>
      <button type="button" class="@BaseButton" @onclick="() => _customPixataWindow.Maximize()">Maximize()</button>
      <button type="button" class="@BaseButton" @onclick="() => _customPixataWindow.Restore()">Restore()</button>
    </div>
    <PixataWindow @ref="_customPixataWindow"
                  @bind-Visible="_customPixata"
                  Top="160px"
                  Left="320px"
                  Width="320px"
                  MinWidth="240px"
                  MaxWidth="560px"
                  MinHeight="160px"
                  MaxHeight="400px"
                  PersistContent="true"
                  ThemeColor="@PixataThemeConstants.ThemeColor.Primary">
      <WindowTitle>Refreshed @_refreshesPixata times</WindowTitle>
      <WindowActions>
        <PixataWindowAction Name="Refresh" Title="Refresh" Icon="PixataSvgIcons.Refresh" OnClick="() => _refreshesPixata++" />
        <PixataWindowAction Name="Minimize" />
        <PixataWindowAction Name="Maximize" />
        <PixataWindowAction Name="Close" />
      </WindowActions>
      <WindowContent>
        <p>Type something, minimise the window and restore it: it's still there.</p>
        <input placeholder="Notes" />
      </WindowContent>
    </PixataWindow>
  </ChildContent>
</ComponentSample>

<style>
  .window-sample-result {
    margin-top: .5rem;
  }

  .window-sample-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .window-sample-workspace {
    position: relative;
    height: 300px;
    margin-top: .5rem;
    border: 1px dashed #999;
    background-color: #f3f3f3;
  }
</style>

@code {

  private static readonly string BaseButton = PixataCss.Button(null, null, null, null);
  private static readonly string PrimaryButton = PixataCss.Button(PixataThemeConstants.Button.ThemeColor.Primary, null, null, null);

  private static readonly (string Title, string Text)[] Notes = [
    ("Inbox", "3 unread messages"),
    ("Calendar", "Meeting with the accountant at 2pm"),
    ("Notes", "Remember to order more paper")
  ];

  private bool _basicPixata;
  private PixataWindowState _basicPixataState;
  private string _basicPixataTop = "120px";
  private string _basicPixataLeft = "300px";
  private string _basicPixataWidth = "360px";
  private string? _basicPixataHeight;

  private bool _modalPixata;

  private readonly bool[] _severalPixata = new bool[3];

  private bool _containedPixata;

  private bool _customPixata;
  private PixataWindow _customPixataWindow = null!;
  private int _refreshesPixata;

  private void ShowSeveral(bool pixata) {
    bool[] visible = _severalPixata;
    Array.Fill(visible, true);
  }

}
