@page "/TabStripSample"
@using Pixata.Blazor.Sample.Models

<SitePageTitle>Tab strip</SitePageTitle>

<h3>Tab strip</h3>

<p>
  <code>PixataTabStrip</code> and <code>PixataTab</code>. See <a href="https://github.com/MrYossu/Pixata.Utilities/blob/master/Pixata.Blazor/Readme.TabStrip.md">the documentation</a>.
</p>

<ComponentSample Title="Basic use">
  <Description>
    Bound to <code>ActiveTabId</code>, with a disabled tab and a header template. Click a tab, or focus the tabs and use the
    arrow keys, Home and End.
  </Description>
  <ChildContent>
    <PixataTabStrip @bind-ActiveTabId="_pixataBasicTab">
      <PixataTab Id="general" Title="General">
        <p>The general settings go here.</p>
      </PixataTab>
      <PixataTab Id="advanced" Title="Advanced">
        <p>The advanced settings go here.</p>
      </PixataTab>
      <PixataTab Id="disabled" Title="Disabled" Disabled="true">
        <p>You can't get here.</p>
      </PixataTab>
      <PixataTab Id="inbox">
        <HeaderTemplate>
          <PixataIcon Icon="PixataSvgIcons.Info" /> Inbox <span class="tab-badge">3</span>
        </HeaderTemplate>
        <Content>
          <p>A tab with a header template.</p>
        </Content>
      </PixataTab>
    </PixataTabStrip>
    <p class="mt-2">Active tab: <strong>@_pixataBasicTab</strong></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Loading data before a tab is shown">
  <Description>
    <code>ActiveTabId</code> is set one way, and the page handles <code>ActiveTabIdChanged</code> itself, so the tab doesn't
    change until the page sets <code>ActiveTabId</code>. Here the "Statements" tab takes a second to load its data, and isn't
    shown until it has. With "Locked" ticked, the handler doesn't set <code>ActiveTabId</code>, so the tab doesn't change at all.
    <span class="ml-3"><PixataSwitch Id="owned-locked-switch" @bind-Value="_ownedLocked" Size="sm" /> <label for="owned-locked-switch">Locked</label></span>
  </Description>
  <ChildContent>
    <PixataTabStrip ActiveTabId="@_ownedTab" ActiveTabIdChanged="OwnedTabChanged">
      <PixataTab Id="details" Title="Details">
        <p>The property's details go here.</p>
      </PixataTab>
      <PixataTab Id="statements" Title="Statements">
        <ul>
          @foreach (string statement in _statements!) {
            <li>@statement</li>
          }
        </ul>
      </PixataTab>
    </PixataTabStrip>
    <p class="mt-2">Active tab: <strong>@_ownedTab</strong>. @_ownedMessage</p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Position, alignment and size">
  <Description>
    <label>Position
      <PixataDropDownList Data="@(Enum.GetValues<PixataTabPosition>())" @bind-Value="_position" AriaLabel="Position" Width="12em" Size="sm" />
    </label>
    <label class="ml-3">Alignment
      <PixataDropDownList Data="@(Enum.GetValues<PixataTabStripTabAlignment>())" @bind-Value="_alignment" AriaLabel="Alignment" Width="12em" Size="sm" />
    </label>
    <label class="ml-3">Size
      <PixataDropDownList Data="@Sizes" @bind-Value="_size" AriaLabel="Size" Width="12em" Size="sm" />
    </label>
  </Description>
  <ChildContent>
    <PixataTabStrip TabPosition="_position" TabAlignment="_alignment" Size="@_size" Height="@(IsVertical ? "180px" : null)">
      <PixataTab Title="Paris">Paris is the capital of France.</PixataTab>
      <PixataTab Title="London">London is the capital of England.</PixataTab>
      <PixataTab Title="Sofia">Sofia is the capital of Bulgaria.</PixataTab>
    </PixataTabStrip>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Scrollable tabs">
  <Description>
    When there are more tabs than fit, a scrollable tab strip keeps them on one line. Swipe the tabs on a phone, or use the
    scroll buttons.
    <label class="ml-3">Buttons
      <PixataDropDownList Data="@(Enum.GetValues<PixataTabStripScrollButtonsPosition>())" @bind-Value="_scrollButtonsPosition" AriaLabel="Buttons" Width="12em" Size="sm" />
    </label>
    <label class="ml-3">Visibility
      <PixataDropDownList Data="@(Enum.GetValues<PixataTabStripScrollButtonsVisibility>())" @bind-Value="_scrollButtonsVisibility" AriaLabel="Visibility" Width="12em" Size="sm" />
    </label>
  </Description>
  <ChildContent>
    <PixataTabStrip Scrollable="true" ScrollButtonsPosition="_scrollButtonsPosition" ScrollButtonsVisibility="_scrollButtonsVisibility" @bind-ActiveTabId="_pixataMonth">
      @foreach (string month in Months) {
        <PixataTab Id="@month" Title="@month">The figures for @month.</PixataTab>
      }
    </PixataTabStrip>
    <p class="mt-2">Active tab: <strong>@_pixataMonth</strong></p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Dynamic and closeable tabs">
  <Description>
    Tabs added, removed and moved at runtime. The tabs can be closed with their close buttons (or the Delete key). The tab strip
    raises <code>OnTabClose</code>, which can cancel the close: try closing the "Pinned" tab. It also has a suffix template with
    an add button.
  </Description>
  <ChildContent>
    <PixataTabStrip Scrollable="true" @bind-ActiveTabId="_pixataDocument" OnTabClose="PixataTabClosing">
      <TabStripSuffixTemplate>
        <button type="button" class="pixata-blazor-button pixata-blazor-button-md pixata-blazor-rounded-md pixata-blazor-button-flat pixata-blazor-button-base pixata-blazor-icon-button" title="Add a document" @onclick="AddPixataDocument">
          <PixataIcon Icon="PixataSvgIcons.Plus" />
        </button>
      </TabStripSuffixTemplate>
      <ChildContent>
        @foreach (string document in _pixataDocuments) {
          <PixataTab @key="document" Id="@document" Title="@document" Closeable="true">Editing @document</PixataTab>
        }
      </ChildContent>
    </PixataTabStrip>
    <p class="mt-2">
      <button class="btn btn-sm btn-outline-primary" @onclick="AddPixataDocument">Add a tab</button>
      <button class="btn btn-sm btn-outline-primary" @onclick="InsertPixataDocument">Insert a tab second</button>
      <button class="btn btn-sm btn-outline-secondary" @onclick="RemovePixataDocument" disabled="@(_pixataDocuments.Count == 0)">Remove the active tab</button>
      <button class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataDocuments.Reverse()">Reverse the tabs</button>
    </p>
    <p>Active tab: <strong>@_pixataDocument</strong>. @_pixataCloseMessage</p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Persisting tab content">
  <Description>
    Type something into the text boxes, switch tabs and come back. With <code>PersistTabContent</code> turned on, what you
    typed is still there, as the tab's content was kept rather than created afresh.
    <span class="ml-3"><PixataSwitch Id="persist-switch" @bind-Value="_persist" Size="sm" /> <label for="persist-switch">PersistTabContent</label></span>
  </Description>
  <ChildContent>
    <PixataTabStrip PersistTabContent="_persist">
      <PixataTab Title="Name"><PixataTextBox Placeholder="Type your name" Width="250px" aria-label="Name" /></PixataTab>
      <PixataTab Title="Address"><PixataTextBox Placeholder="Type your address" Width="250px" aria-label="Address" /></PixataTab>
    </PixataTabStrip>
  </ChildContent>
</ComponentSample>

<style>
  .tab-badge {
    display: inline-block;
    min-width: 1.25rem;
    padding: 0 .3rem;
    border-radius: 1rem;
    background: var(--pixata-blazor-primary);
    color: #fff;
    font-size: .75rem;
    line-height: 1.25rem;
    text-align: center;
  }
</style>

@code {
  private static readonly string[] Months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

  private string _pixataBasicTab = "advanced";
  private PixataTabPosition _position = PixataTabPosition.Top;
  private PixataTabStripTabAlignment _alignment = PixataTabStripTabAlignment.Start;
  private static readonly SampleOption[] Sizes = [new("Small", "sm"), new("Medium", "md"), new("Large", "lg")];
  private string _size = "md";
  private PixataTabStripScrollButtonsPosition _scrollButtonsPosition = PixataTabStripScrollButtonsPosition.Split;
  private PixataTabStripScrollButtonsVisibility _scrollButtonsVisibility = PixataTabStripScrollButtonsVisibility.Auto;
  private string _pixataMonth = "June";
  private bool _persist = true;

  private readonly List<string> _pixataDocuments = ["Pinned", "Report", "Letter", "Invoice"];
  private string? _pixataDocument = "Report";
  private string _pixataCloseMessage = "";
  private int _documentNumber = 1;

  private string _ownedTab = "details";
  private bool _ownedLocked;
  private string _ownedMessage = "";
  // Null until the Statements tab is first selected, so its content would throw if it were shown before the data had loaded
  private List<string>? _statements;

  private async Task OwnedTabChanged(string id) {
    if (_ownedLocked) {
      _ownedMessage = $"Locked, so the tab didn't change to {id}.";
      return;
    }
    if (id == "statements" && _statements is null) {
      _ownedMessage = "Loading the statements...";
      StateHasChanged();
      await Task.Delay(1000);
      _statements = ["January statement", "February statement", "March statement"];
    }
    _ownedMessage = "";
    _ownedTab = id;
  }

  private bool IsVertical =>
    _position is PixataTabPosition.Left or PixataTabPosition.Right;

  private void PixataTabClosing(PixataTabStripTabCloseEventArgs args) {
    if (args.TabId == "Pinned") {
      args.IsCancelled = true;
      _pixataCloseMessage = "The pinned tab can't be closed.";
      return;
    }
    _pixataDocuments.Remove(args.TabId);
    _pixataCloseMessage = $"Closed {args.TabId}.";
  }

  private void AddPixataDocument() {
    string document = $"Document {_documentNumber++}";
    _pixataDocuments.Add(document);
    _pixataDocument = document;
  }

  private void InsertPixataDocument() {
    string document = $"Document {_documentNumber++}";
    _pixataDocuments.Insert(Math.Min(1, _pixataDocuments.Count), document);
    _pixataDocument = document;
  }

  private void RemovePixataDocument() {
    if (_pixataDocument is not null) {
      _pixataDocuments.Remove(_pixataDocument);
    }
  }

}
