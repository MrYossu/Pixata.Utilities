@code {
  private readonly List<GridSampleEmployee> _employees = GridSampleEmployee.All();
  private PixataGridSize _size = PixataGridSize.Medium;
  private bool _empty;
  private bool _multipleSort;

  private PixataGrid<GridSampleEmployee>? _groupedGrid;
  private string _columnEvent = "";
  private List<PixataGridHighlightedCell<GridSampleEmployee>> _pixataHighlightedCells =>
    [new(Data.First(), nameof(GridSampleEmployee.Salary))];

  // Some of the grid's text in Hebrew, to show translation
  private static readonly PixataGridMessages HebrewMessages = new() {
    NoRecords = "אין רשומות.",
    PagerFirstPage = "לעמוד הראשון",
    PagerPreviousPage = "לעמוד הקודם",
    PagerNextPage = "לעמוד הבא",
    PagerLastPage = "לעמוד האחרון",
    PagerInfoFormat = "{0} - {1} מתוך {2} פריטים",
    PagerNavigationFormat = "ניווט בין עמודים, עמוד {0} מתוך {1}",
    GroupPanelEmpty = "גררו כותרת עמודה לכאן כדי לקבץ לפיה",
    Clear = "ניקוי",
    IsEqualTo = "שווה ל",
    IsNotEqualTo = "שונה מ",
    Contains = "מכיל",
    DoesNotContain = "לא מכיל",
    StartsWith = "מתחיל ב",
    EndsWith = "מסתיים ב",
    IsLessThan = "קטן מ",
    IsGreaterThan = "גדול מ",
    SortedAscending = "ממוין בסדר עולה",
    SortedDescending = "ממוין בסדר יורד"
  };
  private bool _exportAllPages;
  private PixataGrid<GridSampleEmployee>? _exportGrid;

  private string? _exports;

  // What the grid exports: the CSV, then a summary of the Excel file
  private async Task ShowExports() {
    MemoryStream csv = (await _exportGrid!.ExportToCsv())!;
    MemoryStream excel = (await _exportGrid.ExportToExcel())!;
    _exports = $"{Describe(csv)}\n{DescribeExcel(excel)}";
  }

  private static string Describe(MemoryStream stream) {
    byte[] bytes = stream.ToArray();
    bool bom = bytes.Length >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF;
    return $"CSV ({bytes.Length} bytes, {(bom ? "with" : "without")} a BOM)\n{System.Text.Encoding.UTF8.GetString(bytes).TrimStart('\uFEFF')}";
  }

  private static string DescribeExcel(MemoryStream stream) {
    using XLWorkbook workbook = new(new MemoryStream(stream.ToArray()));
    IXLWorksheet sheet = workbook.Worksheets.First();
    IXLRange used = sheet.RangeUsed()!;
    System.Text.StringBuilder text = new($"Excel: sheet {sheet.Name}, {used.RowCount()} rows\n");
    text.Append("Widths: ").AppendLine(string.Join(", ", Enumerable.Range(1, used.ColumnCount()).Select(c => sheet.Column(c).Width.ToString("0.#"))));
    foreach (IXLRangeRow row in used.Rows().Take(3)) {
      text.AppendLine(string.Join(" | ", row.Cells().Select(c => $"{c.Value} [{c.DataType}{(c.Style.NumberFormat.Format is { Length: > 0 } f ? " " + f : c.Style.DateFormat.Format is { Length: > 0 } d ? " " + d : "")}{(c.Style.Font.Bold ? " bold" : "")}]")));
    }
    return text.ToString();
  }
  private int _pixataExpands;
  private int _pixataCollapses;
  private PixataGrid<GridSampleEmployee>? _pixataDragLeft;
  private PixataGrid<GridSampleEmployee>? _pixataDragRight;
  private List<GridSampleEmployee> _pixataLeft = GridSampleEmployee.All().Take(5).ToList();
  private List<GridSampleEmployee> _pixataRight = GridSampleEmployee.All().Skip(5).Take(5).ToList();

  // Moves the dropped rows from the grid they came from to where they were dropped
  private void PixataRowDrop(PixataGridRowDropEventArgs<GridSampleEmployee> args, List<GridSampleEmployee> source) {
    if (args.DestinationGrid is null) {
      return;
    }
    List<GridSampleEmployee> destination = args.DestinationGrid == _pixataDragRight ? _pixataRight : _pixataLeft;
    foreach (GridSampleEmployee item in args.Items) {
      source.Remove(item);
    }
    int index = args.DestinationItem is null ? destination.Count : destination.IndexOf(args.DestinationItem) + (args.DropPosition == PixataGridDropPosition.After ? 1 : 0);
    destination.InsertRange(Math.Clamp(index, 0, destination.Count), args.Items);
    _pixataLeft = [.. _pixataLeft];
    _pixataRight = [.. _pixataRight];
  }

  private PixataGrid<GridSampleEmployee>? _stateGrid;
  private PixataGridState<GridSampleEmployee>? _pixataSavedState;
  private string _pixataStateChange = "";

  // Starts the grid grouped by pet
  protected override void OnAfterRender(bool firstRender) {
    if (firstRender) {
      _groupedGrid?.GroupBy(nameof(GridSampleEmployee.Pet));
    }
  }

  private string _editMode = "inline";

  private PixataGridEditMode PixataEditMode => _editMode switch {
    "popup" => PixataGridEditMode.Popup,
    "incell" => PixataGridEditMode.InCell,
    _ => PixataGridEditMode.Inline
  };
  private List<GridSampleEditableEmployee> _pixataEditable = GridSampleEditableEmployee.Some();

  private void PixataCreate(PixataGridCommandEventArgs<GridSampleEditableEmployee> args) {
    args.Item.Id = _pixataEditable.Max(e => e.Id) + 1;
    _pixataEditable.Insert(0, args.Item);
  }

  private void PixataUpdate(PixataGridCommandEventArgs<GridSampleEditableEmployee> args) =>
    _pixataEditable[_pixataEditable.FindIndex(e => e.Id == args.Item.Id)] = args.Item;

  private void PixataDelete(PixataGridCommandEventArgs<GridSampleEditableEmployee> args) =>
    _pixataEditable.RemoveAll(e => e.Id == args.Item.Id);

  private IEnumerable<GridSampleEmployee> _pixataSelected = [];
  private IEnumerable<PixataGridSelectedCell<GridSampleEmployee>> _selectedCells = [];
  private string _rowEvent = "Click a row in the PixataGrid";

  private static void PixataRowRender(PixataGridRowRenderEventArgs<GridSampleEmployee> args) =>
    args.Class = args.Item.IsManager ? "sample-manager-row" : null;

  private static void PixataSalaryRender(PixataGridCellRenderEventArgs<GridSampleEmployee> args) =>
    args.Class = args.Value is decimal salary && salary > 300000 ? "sample-high-salary" : null;

  private void RowClicked(PixataGridRowClickEventArgs<GridSampleEmployee> args) =>
    _rowEvent = $"Clicked {args.Item.FirstName} {args.Item.Surname}, in the {args.Field ?? "name"} column";

  private void RowRightClicked(PixataGridRowClickEventArgs<GridSampleEmployee> args) =>
    _rowEvent = $"Right-clicked {args.Item.FirstName} at {args.EventArgs.ClientX}, {args.EventArgs.ClientY}";

  private async Task ReadEmployees(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(1500), args.CancellationToken));

  private async Task ReadEmployeesVirtually(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(500), args.CancellationToken));

  // Thirty columns, going round the employee's fields
  private static readonly List<(string Field, string Title)> WideColumns = [.. Enumerable.Range(1, 30).Select(n => {
    string field = new[] { nameof(GridSampleEmployee.Id), nameof(GridSampleEmployee.FirstName), nameof(GridSampleEmployee.Surname), nameof(GridSampleEmployee.Email), nameof(GridSampleEmployee.Pet), nameof(GridSampleEmployee.Salary) }[(n - 1) % 6];
    return (field, $"{field} {n}");
  })];

  private string _filterMode = "row";

  private PixataGridFilterMenuType PixataFilterMenuType =>
    _filterMode == "checkbox" ? PixataGridFilterMenuType.CheckBoxList : PixataGridFilterMenuType.Menu;

  private int _pageSize = 3;
  private int _page = 1;
  private readonly List<int?> _pageSizes = [3, 5, 10, null];
  private PixataGridPagerInputType _pagerInputType = PixataGridPagerInputType.Buttons;
  private PixataGridPagerPosition _pagerPosition = PixataGridPagerPosition.Bottom;

  private List<GridSampleEmployee> Data =>
    _empty ? [] : _employees;

}
