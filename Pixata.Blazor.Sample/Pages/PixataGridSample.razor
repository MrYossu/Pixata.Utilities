@page "/pixata-grid"
@using Pixata.Blazor.Components
@using Pixata.Blazor.Components.Grid
@using Pixata.Blazor.Sample.Models
@using Pixata.Blazor.Sample.Data
@using Pixata.Extensions.Grid
@using Telerik.DataSource
@using Telerik.DataSource.Extensions
@inject GridSampleEmployeeService EmployeeService

<SitePageTitle>Pixata grid</SitePageTitle>

<h3>Pixata grid</h3>

<p><code>PixataGrid</code> is a grid that looks and behaves like the Telerik Blazor grid, without needing Telerik. It is being built up in stages (see <a href="https://github.com/MrYossu/Pixata.Utilities/issues/49">issue #49</a>), so this page will grow as features are added.</p>

<p>Each example shows a <code>PixataGrid</code> with a Telerik grid underneath it, bound to the same data with the same settings, so you can compare them.</p>

<div class="pixata-blazor-grid-sample-options">
  <label>
    Size
    <select @bind="_size">
      @foreach (PixataGridSize size in Enum.GetValues<PixataGridSize>()) {
        <option value="@size">@size</option>
      }
    </select>
  </label>
  <label>
    <input type="checkbox" @bind="_empty" />
    No data
  </label>
</div>

<h4>Declared columns</h4>

<p>The First name column has a width, Date of birth gets its format from a <code>[DisplayFormat]</code> attribute, Salary has a <code>DisplayFormat</code> and is right-aligned, and City is a nested field (<code>Address.City</code>). Columns without a <code>Title</code> get one from a <code>[Display(Name)]</code> attribute, or else from the field name split into words (so <code>DateOfBirth</code> becomes "Date of birth"). Telerik doesn't split the field name, so its headers differ there on purpose.</p>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid Data="Data" Size="_size" Height="300px">
  <GridColumns>
    <PixataGridColumn Field="@nameof(GridSampleEmployee.FirstName)" Width="140px" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Email)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" TextAlign="PixataGridTextAlign.Right" />
    <PixataGridColumn Field="Address.City" Title="City" />
  </GridColumns>
</PixataGrid>

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid Data="Data" Size="@TelerikSize" Height="300px">
  <GridColumns>
    <GridColumn Field="@nameof(GridSampleEmployee.FirstName)" Width="140px" />
    <GridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Email)" />
    <GridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" TextAlign="ColumnTextAlign.Right" />
    <GridColumn Field="Address.City" Title="City" />
  </GridColumns>
</TelerikGrid>

<h4>Paging</h4>

<p>Both grids are bound to the same <code>Page</code> and <code>PageSize</code>, so moving one moves the other. The pager shows 5 page buttons at a time, and offers page sizes of 3, 5, 10 and All. Narrow the window to see the pager adapt.</p>

<div class="pixata-blazor-grid-sample-options">
  <label>
    Pager input
    <select @bind="_pagerInputType">
      @foreach (PixataGridPagerInputType inputType in Enum.GetValues<PixataGridPagerInputType>()) {
        <option value="@inputType">@inputType</option>
      }
    </select>
  </label>
  <label>
    Pager position
    <select @bind="_pagerPosition">
      @foreach (PixataGridPagerPosition position in Enum.GetValues<PixataGridPagerPosition>()) {
        <option value="@position">@position</option>
      }
    </select>
  </label>
  <span>Page @_page, page size @_pageSize</span>
</div>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid Data="Data" Size="_size" Pageable="true" @bind-PageSize="_pageSize" @bind-Page="_page">
  <GridSettings>
    <PixataGridPagerSettings ButtonCount="5" PageSizes="@_pageSizes" InputType="_pagerInputType" Position="_pagerPosition" />
  </GridSettings>
  <GridColumns>
    <PixataGridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Email)" />
  </GridColumns>
</PixataGrid>

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid Data="Data" Size="@TelerikSize" Pageable="true" @bind-PageSize="_pageSize" @bind-Page="_page">
  <GridSettings>
    <GridPagerSettings ButtonCount="5" PageSizes="@_pageSizes" InputType="@TelerikInputType" Position="@TelerikPagerPosition" />
  </GridSettings>
  <GridColumns>
    <GridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Email)" />
  </GridColumns>
</TelerikGrid>

<h4>Sorting</h4>

<p>Click a header to sort by that column. Clicking again sorts the other way, and a third click removes the sort. In multiple mode, each click adds to the sort, and the header shows the order. City is a nested field.</p>

<div class="pixata-blazor-grid-sample-options">
  <label>
    <input type="checkbox" @bind="_multipleSort" />
    Sort by several columns
  </label>
</div>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid Data="Data" Size="_size" Sortable="true" SortMode="@(_multipleSort ? PixataGridSortMode.Multiple : PixataGridSortMode.Single)" Pageable="true" PageSize="5">
  <GridColumns>
    <PixataGridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" TextAlign="PixataGridTextAlign.Right" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.IsManager)" Sortable="false" Title="Manager (not sortable)" />
    <PixataGridColumn Field="Address.City" Title="City" />
  </GridColumns>
</PixataGrid>

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid Data="Data" Size="@TelerikSize" Sortable="true" SortMode="@(_multipleSort ? SortMode.Multiple : SortMode.Single)" Pageable="true" PageSize="5">
  <GridColumns>
    <GridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <GridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" TextAlign="ColumnTextAlign.Right" />
    <GridColumn Field="@nameof(GridSampleEmployee.IsManager)" Sortable="false" Title="Manager (not sortable)" />
    <GridColumn Field="Address.City" Title="City" />
  </GridColumns>
</TelerikGrid>

<h4>Filtering</h4>

<div class="pixata-blazor-grid-sample-options">
  <label>
    Filter mode
    <select @bind="_filterMode">
      <option value="row">Filter row</option>
      <option value="menu">Filter menu</option>
      <option value="checkbox">Filter menu with checkbox lists</option>
    </select>
  </label>
</div>

<p>Try the filter row, the filter menus and the search box (which searches the text columns). City can't be filtered, but it can be searched.</p>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid Data="Data" Size="_size" FilterMode="@(_filterMode == "row" ? PixataGridFilterMode.FilterRow : PixataGridFilterMode.FilterMenu)" Pageable="true" PageSize="5" Sortable="true">
  <GridToolBarTemplate>
    <PixataGridSearchBox />
  </GridToolBarTemplate>
  <GridColumns>
    <PixataGridColumn Field="@nameof(GridSampleEmployee.FirstName)" FilterMenuType="@PixataFilterMenuType" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" FilterMenuType="@PixataFilterMenuType" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" FilterMenuType="@PixataFilterMenuType" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.IsManager)" FilterMenuType="@PixataFilterMenuType" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Pet)" FilterMenuType="@PixataFilterMenuType" />
    <PixataGridColumn Field="Address.City" Title="City" Filterable="false" />
  </GridColumns>
</PixataGrid>

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid Data="Data" Size="@TelerikSize" FilterMode="@(_filterMode == "row" ? GridFilterMode.FilterRow : GridFilterMode.FilterMenu)" Pageable="true" PageSize="5" Sortable="true">
  <GridToolBarTemplate>
    <GridSearchBox />
  </GridToolBarTemplate>
  <GridColumns>
    <GridColumn Field="@nameof(GridSampleEmployee.FirstName)" FilterMenuType="@TelerikFilterMenuType" />
    <GridColumn Field="@nameof(GridSampleEmployee.DateOfBirth)" FilterMenuType="@TelerikFilterMenuType" />
    <GridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" FilterMenuType="@TelerikFilterMenuType" />
    <GridColumn Field="@nameof(GridSampleEmployee.IsManager)" FilterMenuType="@TelerikFilterMenuType" />
    <GridColumn Field="@nameof(GridSampleEmployee.Pet)" FilterMenuType="@TelerikFilterMenuType" />
    <GridColumn Field="Address.City" Title="City" Filterable="false" />
  </GridColumns>
</TelerikGrid>

<h4>Supplying the data with OnRead</h4>

<p>These grids get their data from the sample app's database through <code>OnRead</code>, so only the page being shown is loaded. Each read is slowed down to 1.5 seconds, so you can see the loading indicator when you page, sort or filter (as in Telerik, it isn't shown for the first read). The PixataGrid uses <code>ToGridResultAsync()</code> from Pixata.AspNetCore, which runs the paging, sorting and filtering in the database.</p>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid TItem="GridSampleEmployee" OnRead="ReadEmployees" Size="_size" Pageable="true" PageSize="5" Sortable="true" FilterMode="PixataGridFilterMode.FilterRow">
  <GridColumns>
    <PixataGridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <PixataGridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" />
    <PixataGridColumn Field="Address.City" Title="City" />
  </GridColumns>
</PixataGrid>

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid TItem="GridSampleEmployee" OnRead="ReadEmployeesForTelerik" Size="@TelerikSize" Pageable="true" PageSize="5" Sortable="true" FilterMode="GridFilterMode.FilterRow">
  <GridColumns>
    <GridColumn Field="@nameof(GridSampleEmployee.FirstName)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Surname)" />
    <GridColumn Field="@nameof(GridSampleEmployee.Salary)" DisplayFormat="{0:C2}" />
    <GridColumn Field="Address.City" Title="City" />
  </GridColumns>
</TelerikGrid>

<h4>Auto-generated columns</h4>

<p>With <code>AutoGenerateColumns="true"</code> and no <code>GridColumns</code>, there's a column for each simple public property. Phone is left out by <code>[Display(AutoGenerateField = false)]</code>, and Address, being an object, is left out by <code>PixataGrid</code>. The grid has no height, so it is as tall as its rows.</p>

<p class="pixata-blazor-grid-sample-label">PixataGrid</p>
<PixataGrid Data="Data.Take(5)" Size="_size" AutoGenerateColumns="true" />

<p class="pixata-blazor-grid-sample-label">Telerik grid</p>
<TelerikGrid Data="Data.Take(5)" Size="@TelerikSize" AutoGenerateColumns="true" />

<style>
  .pixata-blazor-grid-sample-options {
    display: flex;
    gap: 2rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .pixata-blazor-grid-sample-label {
    margin: 1rem 0 .25rem;
    font-weight: bold;
  }
</style>

@code {
  private readonly List<GridSampleEmployee> _employees = GridSampleEmployee.All();
  private PixataGridSize _size = PixataGridSize.Medium;
  private bool _empty;
  private bool _multipleSort;

  private async Task ReadEmployees(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(1500), args.CancellationToken));

  private async Task ReadEmployeesForTelerik(GridReadEventArgs args) {
    await Task.Delay(1500);
    DataSourceResult result = GridSampleEmployee.All().ToDataSourceResult(args.Request);
    args.Data = result.Data;
    args.Total = result.Total;
  }
  private string _filterMode = "row";

  private PixataGridFilterMenuType PixataFilterMenuType =>
    _filterMode == "checkbox" ? PixataGridFilterMenuType.CheckBoxList : PixataGridFilterMenuType.Menu;

  private FilterMenuType TelerikFilterMenuType =>
    _filterMode == "checkbox" ? FilterMenuType.CheckBoxList : FilterMenuType.Menu;
  private int _pageSize = 3;
  private int _page = 1;
  private readonly List<int?> _pageSizes = [3, 5, 10, null];
  private PixataGridPagerInputType _pagerInputType = PixataGridPagerInputType.Buttons;
  private PixataGridPagerPosition _pagerPosition = PixataGridPagerPosition.Bottom;

  private List<GridSampleEmployee> Data =>
    _empty ? [] : _employees;

  private string TelerikSize => _size switch {
    PixataGridSize.Small => ThemeConstants.Grid.Size.Small,
    _ => ThemeConstants.Grid.Size.Medium
  };

  private PagerInputType TelerikInputType =>
    _pagerInputType == PixataGridPagerInputType.Input ? PagerInputType.Input : PagerInputType.Buttons;

  private PagerPosition TelerikPagerPosition =>
    _pagerPosition == PixataGridPagerPosition.Top ? PagerPosition.Top : PagerPosition.Bottom;
}
