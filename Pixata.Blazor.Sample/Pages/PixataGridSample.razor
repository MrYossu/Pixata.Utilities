  private async Task ReadEmployees(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(1500), args.CancellationToken));

  private async Task ReadEmployeesForTelerik(GridReadEventArgs args) {
    await Task.Delay(1500);
