  private void RowClicked(PixataGridRowClickEventArgs<GridSampleEmployee> args) =>
    _rowEvent = $"Clicked {args.Item.FirstName} {args.Item.Surname}, in the {args.Field ?? "name"} column";

  private void RowRightClicked(PixataGridRowClickEventArgs<GridSampleEmployee> args) =>
    _rowEvent = $"Right-clicked {args.Item.FirstName} at {args.EventArgs.ClientX}, {args.EventArgs.ClientY}";

  private async Task ReadEmployees(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(1500), args.CancellationToken));

  private async Task ReadEmployeesVirtually(PixataGridReadEventArgs<GridSampleEmployee> args) =>
    args.SetResult(await EmployeeService.Read(args.Request, TimeSpan.FromMilliseconds(500), args.CancellationToken));

  private async Task ReadEmployeesVirtuallyForTelerik(GridReadEventArgs args) {
    await Task.Delay(500);
    DataSourceResult result = GridSampleEmployee.All().ToDataSourceResult(args.Request);
    args.Data = result.Data;
    args.Total = result.Total;
  }

  // Thirty columns, going round the employee's fields
  private static readonly List<(string Field, string Title)> WideColumns = [.. Enumerable.Range(1, 30).Select(n => {
    string field = new[] { nameof(GridSampleEmployee.Id), nameof(GridSampleEmployee.FirstName), nameof(GridSampleEmployee.Surname), nameof(GridSampleEmployee.Email), nameof(GridSampleEmployee.Pet), nameof(GridSampleEmployee.Salary) }[(n - 1) % 6];
    return (field, $"{field} {n}");
  })];

  private async Task ReadEmployeesForTelerik(GridReadEventArgs args) {
