@page "/TelerikFormRows"
@using Pixata.Blazor.Components
@using Pixata.Blazor.Sample.Models

<SitePageTitle>Telerik form rows</SitePageTitle>

<h3>Telerik form rows</h3>

<p>
  The form rows in <a href="https://github.com/MrYossu/Pixata.Utilities/tree/master/Pixata.Blazor.TelerikComponents">Pixata.Blazor.TelerikComponents</a>,
  which use Telerik's input controls. They follow the same layout as the form rows in Pixata.Blazor (see the
  <a href="FormSample">form components</a> page), and use its stylesheet.
</p>

<div style="border: 1px solid #000; margin: 20px; padding: 20px 30px">
  <EditForm Model="_person">
    <FluentValidationValidator />
    <FormRowDateTelerik PropertyName="@nameof(Person.DateOfBirth)" @bind-Value="_person.DateOfBirth" Icon="fa fa-house-day" Caption="Date of birth" />
    <FormRowDateNullableTelerik PropertyName="NextAppointment" @bind-Value="_nextAppointment" Icon="fa fa-calendar-check" Caption="Next appointment" ShowTime="true" />
    <FormRowTimeTelerik PropertyName="@nameof(Person.TeaTime)" @bind-Value="_person.TeaTime" Icon="fa fa-clock" Caption="Tea time" />
    <FormRowHtmlEditor PropertyName="@nameof(Person.Notes)" @bind-Value="_person.Notes" Icon="fab fa-itunes-note" Caption="Notes" />
    <FormRowButtons CancelUrl="/" />
  </EditForm>
</div>

@code {
  private readonly Person _person = new() {
    Id = 1,
    Title = "Mr",
    FirstName = "Jim",
    Surname = "Spriggs",
    Email = "jim@spriggs.com",
    DateOfBirth = new(1980, 4, 7),
    TeaTime = DateTime.Today.AddHours(16),
    Notes = "<p>A very nice chap, if a little <strong>weird</strong>.</p><p>Has a pet halibut named Simon.</p>",
    FavouriteFoodId = 1,
    Pet = Pets.Ferret
  };

  private DateTime? _nextAppointment;
}
