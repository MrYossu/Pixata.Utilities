@page "/hebrewdatepicker"

<SitePageTitle>Hebrew date picker</SitePageTitle>

<h3>Hebrew Date Picker</h3>

<div class="row g-4">
  <div class="col-auto">
    <HebrewDatePicker Value="@_date"
                      ValueChanged="@((DateTime d) => _date = d)"
                      MinDate="@_minDate"
                      MaxDate="@_maxDate"
                      Width="@_width"
                      Class="@_class"
                      GregorianPrimary="@_gregorianPrimary"
                      ShowSecondaryDates="@_showSecondaryDates"
                      InputDisplay="@_inputDisplay"
                      ShowTooltips="@_showTooltips"
                      IncludeShabbosOrYomTov="@_includeShabbosOrYomTov"
                      ShabbosOrYomTovBgColour="@_shabbosOrYomTovBgColour"
                      IncludeOtherNonWorkDays="@_includeOtherNonWorkDays"
                      OtherNonWorkDayBgColour="@_otherNonWorkDayBgColour"
                      IncludeBankHolidays="@_includeBankHolidays"
                      BankHolidayBgColour="@_bankHolidayBgColour"
                      ClashPriority="@_clashPriority"
                      OpenOnRight="@_openOnRight"
                      OpenOnFocus="@_openOnFocus"
                      ShowDiagnostics="@_showDiagnostics" />

    @if (_date != default) {
      <p class="mt-2 text-muted"><small>Selected: @_date.ToString("d MMMM yyyy")</small></p>
    }
  </div>

  <div class="col">
    <div class="card">
      <div class="card-header"><strong>Parameters</strong></div>
      <div class="card-body">

        <h6 class="text-muted text-uppercase mb-2" style="font-size: .7rem; letter-spacing: .05em;">Display</h6>
        <div class="row g-2 mb-3 align-items-center">
          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Width</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataTextBox @bind-Value="_width" DebounceDelay="400" Size="sm" Width="120px" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Class</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataTextBox @bind-Value="_class" DebounceDelay="400" Placeholder="(none)" Size="sm" Width="240px" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Input display</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataRadioGroup Data="Enum.GetValues<DateInputDisplay>()" @bind-Value="_inputDisplay" Layout="PixataRadioGroupLayout.Horizontal" AriaLabel="Input display" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="showGregorianDates">Show secondary dates in cells</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="showGregorianDates" @bind-Value="_showSecondaryDates" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="gregorianPrimary">Gregorian primary</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="gregorianPrimary" @bind-Value="_gregorianPrimary" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="showTooltips">Show tooltips</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="showTooltips" @bind-Value="_showTooltips" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="showDiagnostics">Show diagnostics</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="showDiagnostics" @bind-Value="_showDiagnostics" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="openOnRight">Open on right</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="openOnRight" @bind-Value="_openOnRight" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="openOnFocus">Open on focus</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="openOnFocus" @bind-Value="_openOnFocus" />
          </div>
        </div>

        <h6 class="text-muted text-uppercase mb-2" style="font-size: .7rem; letter-spacing: .05em;">Date Range</h6>
        <div class="row g-2 mb-3 align-items-center">
          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Min date</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataDatePicker @bind-Value="_minDate" Min="@EarliestDate" Max="@LatestDate" Width="180px" Size="sm" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Max date</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataDatePicker @bind-Value="_maxDate" Min="@EarliestDate" Max="@LatestDate" Width="180px" Size="sm" />
          </div>
        </div>

        <h6 class="text-muted text-uppercase mb-2" style="font-size: .7rem; letter-spacing: .05em;">Shabbos &amp; Yom Tov</h6>
        <div class="row g-2 mb-3 align-items-center">
          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="includeShabbosOrYomTov">Highlight Shabbos / Yom Tov</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="includeShabbosOrYomTov" @bind-Value="_includeShabbosOrYomTov" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Shabbos / Yom Tov colour</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <div class="d-flex align-items-center gap-2">
              <input type="color" class="form-control form-control-color form-control-sm" @bind="_shabbosOrYomTovBgColour" disabled="@(!_includeShabbosOrYomTov)" />
              <code class="small">@_shabbosOrYomTovBgColour</code>
              <button class="btn btn-outline-secondary btn-sm" @onclick='() => _shabbosOrYomTovBgColour = "#b1c1d7"'>Reset</button>
            </div>
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="includeOtherNonWorkDays">Highlight other non-work days</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="includeOtherNonWorkDays" @bind-Value="_includeOtherNonWorkDays" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Other non-work day colour</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <div class="d-flex align-items-center gap-2">
              <input type="color" class="form-control form-control-color form-control-sm" @bind="_otherNonWorkDayBgColour" disabled="@(!_includeOtherNonWorkDays)" />
              <code class="small">@_otherNonWorkDayBgColour</code>
              <button class="btn btn-outline-secondary btn-sm" @onclick='() => _otherNonWorkDayBgColour = "#d2dae3"'>Reset</button>
            </div>
          </div>
        </div>

        <h6 class="text-muted text-uppercase mb-2" style="font-size: .7rem; letter-spacing: .05em;">Bank Holidays</h6>
        <div class="row g-2 mb-3 align-items-center">
          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0" for="includeBankHolidays">Highlight bank holidays</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataSwitch Id="includeBankHolidays" @bind-Value="_includeBankHolidays" />
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Bank holiday colour</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <div class="d-flex align-items-center gap-2">
              <input type="color" class="form-control form-control-color form-control-sm" @bind="_bankHolidayBgColour" disabled="@(!_includeBankHolidays)" />
              <code class="small">@_bankHolidayBgColour</code>
              <button class="btn btn-outline-secondary btn-sm" @onclick='() => _bankHolidayBgColour = "#d4edda"'>Reset</button>
            </div>
          </div>

          <div class="col-sm-4 col-md-3">
            <label class="form-label mb-0">Clash priority</label>
          </div>
          <div class="col-sm-8 col-md-9">
            <PixataRadioGroup Data="Enum.GetValues<BankHolidayClashPriority>()" @bind-Value="_clashPriority" Layout="PixataRadioGroupLayout.Horizontal" AriaLabel="Clash priority" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <style>
      .hebrew-date-picker .overlay-content {
        display: none;
      }
  </style>
</div>

@code {
  private DateTime _date = DateTime.Today;
  // The picker defaults to 1900 to 2099, which would rule out the Hebrew calendar range's own defaults
  private static readonly DateTime EarliestDate = new(1, 1, 1);
  private static readonly DateTime LatestDate = new(9999, 12, 31);
  private DateTime _minDate = new(1584, 1, 1);
  private DateTime _maxDate = new(2238, 9, 29);
  private string _width = "320px";
  private string _class = "";
  private bool _gregorianPrimary;
  private bool _showSecondaryDates;
  private DateInputDisplay _inputDisplay = DateInputDisplay.Hebrew;
  private bool _showTooltips = true;
  private bool _showDiagnostics;
  private bool _includeShabbosOrYomTov;
  private string _shabbosOrYomTovBgColour = "#b1c1d7";
  private bool _includeOtherNonWorkDays;
  private string _otherNonWorkDayBgColour = "#d2dae3";
  private bool _includeBankHolidays;
  private string _bankHolidayBgColour = "#d4edda";
  private BankHolidayClashPriority _clashPriority = BankHolidayClashPriority.HebrewFirst;
  private bool _openOnRight;
  private bool _openOnFocus = true;
}
