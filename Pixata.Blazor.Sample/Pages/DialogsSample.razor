@page "/DialogsSample"
@using System.ComponentModel.DataAnnotations

<SitePageTitle>Dialogs</SitePageTitle>

<h3>Dialogs</h3>

<p>
  <code>PixataDialog</code>, and the predefined alert, confirm and prompt dialogs from <code>PixataDialogFactory</code>. See
  <a href="https://github.com/MrYossu/Pixata.Utilities/blob/master/Pixata.Blazor/Readme.Dialogs.md">the documentation</a>.
  Try the keyboard too: the focus moves into a dialog when it opens, Tab stays inside it, Esc closes it, and the focus goes
  back to the button that opened it afterwards.
</p>

<ComponentSample Title="A basic dialog">
  <Description>
    A title, some content and a couple of buttons, with <code>@@bind-Visible</code>. The close button and Esc close it too.
  </Description>
  <ChildContent>
    <button type="button" class="@PrimaryButton" @onclick="() => _basicPixata = true">Delete customer</button>
    <PixataDialog @bind-Visible="_basicPixata" Title="Delete customer" Width="400px">
      <DialogContent>
        <p>Are you sure you want to delete Fred Bloggs? His orders and invoices will be deleted too.</p>
      </DialogContent>
      <DialogButtons>
        <button type="button" class="@BaseButton" @onclick="@(() => CloseBasic(true, "Cancelled"))">Cancel</button>
        <button type="button" class="@PrimaryButton" @onclick="@(() => CloseBasic(true, "Deleted"))">Delete</button>
      </DialogButtons>
    </PixataDialog>
    <p class="dialogs-sample-result">Visible: @_basicPixata. Result: @_basicPixataResult</p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Options">
  <Description>
    <div class="dialogs-sample-options">
      <span><PixataSwitch Id="show-close-button-switch" @bind-Value="_showCloseButton" Size="sm" /> <label for="show-close-button-switch">ShowCloseButton</label></span>
      <span><PixataSwitch Id="close-on-overlay-click-switch" @bind-Value="_closeOnOverlayClick" Size="sm" /> <label for="close-on-overlay-click-switch">CloseOnOverlayClick</label></span>
      <label>
        ButtonsLayout
        <PixataDropDownList Data="@(Enum.GetValues<PixataDialogButtonsLayout>())" @bind-Value="_buttonsLayout" AriaLabel="ButtonsLayout" Width="12em" Size="sm" />
      </label>
      <label>
        ThemeColor (Pixata only)
        <PixataDropDownList Data="@ThemeColours" @bind-Value="_themeColor" DefaultText="(none)" AriaLabel="ThemeColor" Width="12em" Size="sm" />
      </label>
    </div>
    Without a close button, Esc doesn't close the dialog either. The ThemeColor colours the titlebar.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => _optionsPixata = true">Open</button>
    <PixataDialog @bind-Visible="_optionsPixata"
                  Title="Options"
                  ShowCloseButton="_showCloseButton"
                  CloseOnOverlayClick="_closeOnOverlayClick"
                  ButtonsLayout="_buttonsLayout"
                  ThemeColor="@_themeColor">
      <DialogContent>
        <p>Change the options above and open the dialog again.</p>
      </DialogContent>
      <DialogButtons>
        <button type="button" class="@BaseButton" @onclick="() => _optionsPixata = false">Cancel</button>
        <button type="button" class="@PrimaryButton" @onclick="() => _optionsPixata = false">OK</button>
      </DialogButtons>
    </PixataDialog>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="A form, a title template, a fixed height and the focused element">
  <Description>
    An <code>EditForm</code> with validation inside the dialog, a <code>DialogTitle</code> with an icon,
    <code>Height="320px"</code> so the content scrolls, and <code>FocusedElementSelector</code> putting the focus in the
    email box. The dialog is still part of the page's component tree, so the form works as it would anywhere else.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="OpenFormPixata">Edit contact</button>
    <PixataDialog @bind-Visible="_formPixata" Width="420px" Height="320px" FocusedElementSelector="#pixata-email">
      <DialogTitle>
        <PixataIcon Icon="PixataSvgIcons.Pencil" /> Edit contact
      </DialogTitle>
      <DialogContent>
        <EditForm id="pixata-contact-form" Model="_contactPixata" OnValidSubmit="() => SaveContact(true)">
          <DataAnnotationsValidator />
          <p><label>Name<br /><PixataTextBox @bind-Value="_contactPixata.Name" /></label></p>
          <ValidationMessage For="() => _contactPixata.Name" />
          <p><label>Email<br /><PixataTextBox Id="pixata-email" @bind-Value="_contactPixata.Email" InputMode="email" AutoComplete="email" /></label></p>
          <ValidationMessage For="() => _contactPixata.Email" />
          <p>@LongText</p>
        </EditForm>
      </DialogContent>
      <DialogButtons>
        <button type="button" class="@BaseButton" @onclick="() => _formPixata = false">Cancel</button>
        <button type="submit" form="pixata-contact-form" class="@PrimaryButton">Save</button>
      </DialogButtons>
    </PixataDialog>
    <p class="dialogs-sample-result">Saved: @_savedPixata</p>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Stacked dialogs, and stopping a dialog closing">
  <Description>
    The first dialog opens a second one (and a predefined confirm dialog) on top of itself. Esc closes the one in front. The
    first dialog handles <code>VisibleChanged</code> itself rather than using <code>@@bind-Visible</code>: with "Unsaved
    changes" ticked, it asks before closing, and stays open if you say no.
  </Description>
  <ChildContent>
    <button type="button" class="@BaseButton" @onclick="() => _outerPixata = true">Open the first dialog</button>
    <PixataDialog Visible="_outerPixata" VisibleChanged="OuterPixataVisibleChanged" Title="First dialog" Width="460px">
      <DialogContent>
        <p><span><PixataSwitch Id="unsaved-pixata-switch" @bind-Value="_unsavedPixata" Size="sm" /> <label for="unsaved-pixata-switch">Unsaved changes</label></span></p>
        <p>
          <button type="button" class="@BaseButton" @onclick="() => _innerPixata = true">Open a second dialog</button>
          <button type="button" class="@BaseButton" @onclick="ConfirmFromPixata">Confirm something</button>
        </p>
        <p>@_stackedPixataResult</p>
        <PixataDialog @bind-Visible="_innerPixata" Title="Second dialog" Width="320px" CloseOnOverlayClick="true">
          <DialogContent>
            <p>This one is in front. Esc, the close button or a click on the overlay closes it, and leaves the first one open.</p>
          </DialogContent>
        </PixataDialog>
      </DialogContent>
      <DialogButtons>
        <button type="button" class="@PrimaryButton" @onclick="() => OuterPixataVisibleChanged(false)">Close</button>
      </DialogButtons>
    </PixataDialog>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Predefined dialogs">
  <Description>
    Called from code and awaited. They come from <code>@@inject PixataDialogFactory Dialogs</code>, with a
    <code>&lt;PixataDialogHost /&gt;</code> in the layout. The last button passes its own button text, as you would to
    translate them for one call.
  </Description>
  <ChildContent>
    <div class="dialogs-sample-buttons">
      <button type="button" class="@BaseButton" @onclick="AlertPixata">Alert</button>
      <button type="button" class="@BaseButton" @onclick="ConfirmPixata">Confirm</button>
      <button type="button" class="@BaseButton" @onclick="PromptPixata">Prompt</button>
      <button type="button" class="@BaseButton" @onclick="YesNoPixata">Confirm with Yes/No</button>
    </div>
    <p class="dialogs-sample-result">@_predefinedPixataResult</p>
  </ChildContent>
</ComponentSample>

<style>
  .dialogs-sample-options {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.5rem;
    margin-bottom: .5rem;
  }

  .dialogs-sample-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .dialogs-sample-result {
    margin-top: .5rem;
  }
</style>

@code {

  [Inject]
  private PixataDialogFactory Dialogs { get; set; } = null!;

  private static readonly string BaseButton = PixataCss.Button(null, null, null, null);
  private static readonly string PrimaryButton = PixataCss.Button(PixataThemeConstants.Button.ThemeColor.Primary, null, null, null);

  private static readonly string[] ThemeColours = [
    PixataThemeConstants.ThemeColor.Primary, PixataThemeConstants.ThemeColor.Secondary, PixataThemeConstants.ThemeColor.Tertiary,
    PixataThemeConstants.ThemeColor.Info, PixataThemeConstants.ThemeColor.Success, PixataThemeConstants.ThemeColor.Warning,
    PixataThemeConstants.ThemeColor.Error, PixataThemeConstants.ThemeColor.Dark, PixataThemeConstants.ThemeColor.Light,
    PixataThemeConstants.ThemeColor.Inverse
  ];

  private const string LongText = "This paragraph is here to make the content taller than the dialog, so that you can see it scroll while the "
    + "titlebar and buttons stay where they are. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus non ex et leo "
    + "ultrices lobortis. Quisque iaculis ullamcorper est luctus vestibulum. Nunc aliquam nisl id enim aliquet elementum. Sed "
    + "vehicula leo id leo vulputate, at viverra risus iaculis. Pellentesque condimentum mauris sapien, non rhoncus sem dictum vel.";

  private bool _basicPixata;
  private string _basicPixataResult = "";

  private bool _optionsPixata;
  private bool _showCloseButton = true;
  private bool _closeOnOverlayClick;
  private PixataDialogButtonsLayout _buttonsLayout = PixataDialogButtonsLayout.Stretch;
  private string? _themeColor;

  private bool _formPixata;
  private Contact _contactPixata = new();
  private string _savedPixata = "";

  private bool _outerPixata;
  private bool _innerPixata;
  private bool _unsavedPixata;
  private string _stackedPixataResult = "";

  private string _predefinedPixataResult = "";

  private void CloseBasic(bool pixata, string result) {
    if (pixata) {
      _basicPixata = false;
      _basicPixataResult = result;
    }
  }

  private void OpenFormPixata() {
    _contactPixata = new() { Name = "Fred Bloggs" };
    _formPixata = true;
  }

  private void SaveContact(bool pixata) {
    if (pixata) {
      _savedPixata = $"{_contactPixata.Name} <{_contactPixata.Email}>";
      _formPixata = false;
    }
  }

  private async Task OuterPixataVisibleChanged(bool visible) {
    if (!visible && _unsavedPixata && !await Dialogs.ConfirmAsync("You have unsaved changes. Close anyway?", "Unsaved changes", "Close", "Keep editing")) {
      return;
    }
    _outerPixata = visible;
  }

  private async Task ConfirmFromPixata() =>
    _stackedPixataResult = $"Confirmed: {await Dialogs.ConfirmAsync("Shown on top of the first dialog. OK?", "Confirm")}";

  private async Task AlertPixata() {
    await Dialogs.AlertAsync("Your changes have been saved.", "Saved");
    _predefinedPixataResult = "The alert was closed";
  }

  private async Task ConfirmPixata() =>
    _predefinedPixataResult = $"Confirm returned {await Dialogs.ConfirmAsync("Do you want to send the invoice now?", "Send invoice")}";

  private async Task PromptPixata() {
    string? name = await Dialogs.PromptAsync("What would you like to call the report?", "Save report", "Monthly sales");
    _predefinedPixataResult = name is null ? "Prompt returned null (cancelled)" : $"Prompt returned \"{name}\"";
  }

  private async Task YesNoPixata() =>
    _predefinedPixataResult = $"Confirm returned {await Dialogs.ConfirmAsync("Delete all 12 drafts?", "Delete drafts", "Yes", "No")}";

  private class Contact {
    [Required]
    public string Name { get; set; } = "";

    [Required]
    [EmailAddress]
    public string Email { get; set; } = "";
  }

}
