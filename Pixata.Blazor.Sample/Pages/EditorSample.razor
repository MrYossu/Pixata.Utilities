@page "/EditorSample"
@using System.ComponentModel.DataAnnotations
@using Pixata.Blazor.Components

<h3>Editor</h3>

<p><code>PixataEditor</code> is a rich text editor whose value is HTML. Press Alt+F10 in the document to move to the toolbar, use the arrow keys to move between the tools, and Esc to go back to the document.</p>

<ComponentSample Title="Basic use">
  <Description>
    <p>Two-way binding with <code>@@bind-Value</code> and the default tools. The value is updated 100ms after you stop typing (<code>DebounceDelay</code>), and straight away when the editor loses the focus.</p>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataBasic" AriaLabel="Basic editor" />
    <pre class="editor-sample-value">@_pixataBasic</pre>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="All the tools">
  <Description>
    <p><code>Tools="PixataEditorToolSets.All"</code> adds undo and redo, strikethrough, subscript and superscript, the font, its size and colours, tables, clearing the formatting and viewing the HTML. Put the cursor in the table to use the row and column tools.</p>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataAll" Tools="PixataEditorToolSets.All" Height="380px" AriaLabel="Editor with all the tools" />
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Div edit mode">
  <Description>
    <p>By default the document is in an iframe, so the page's styles don't affect it. With <code>EditMode="PixataEditorEditMode.Div"</code> it is in a div, and inherits the page's styles. This page makes paragraphs in div-mode editors italic and dark blue, to show the difference.</p>
  </Description>
  <ChildContent>
    <div class="editor-sample-page-styles">
      <PixataEditor @bind-Value="_pixataDiv" EditMode="PixataEditorEditMode.Div" Height="200px" AriaLabel="Div mode editor" />
    </div>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Adaptive toolbar">
  <Description>
    <p>With <code>Adaptive="true"</code> the toolbar stays on one line, and the tools that don't fit go into a menu at its end. Without it (the default) the toolbar wraps. Drag the slider to change the editors' width.</p>
    <label>Width: <input type="range" min="260" max="900" step="10" @bind="_adaptiveWidth" @bind:event="oninput" /> @(_adaptiveWidth)px</label>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataAdaptive" Tools="PixataEditorToolSets.All" Adaptive="true" Width="@($"min(100%, {_adaptiveWidth}px)")" Height="200px" AriaLabel="Adaptive editor" />
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Read-only and disabled">
  <Description>
    <p>A read-only editor's content can be selected and copied but not changed, and its tools are disabled. A disabled editor can't be used at all.</p>
    <label class="me-3"><input type="checkbox" @bind="_readOnly" /> ReadOnly</label>
    <label><input type="checkbox" @bind="_enabled" /> Enabled</label>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataReadOnly" ReadOnly="_readOnly" Enabled="_enabled" Height="180px" AriaLabel="Read-only editor" />
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Custom tools">
  <Description>
    <p>Put a <code>PixataEditorCustomTool</code> in <code>Tools</code>, and its content in a <code>PixataEditorCustomToolTemplate</code> with the same name in <code>EditorCustomTools</code>. These ones use <code>ExecuteAsync()</code> to insert today's date and a signature.</p>
  </Description>
  <ChildContent>
    <PixataEditor @ref="_pixataCustomEditor" @bind-Value="_pixataCustom" Tools="_pixataCustomTools" Height="200px" AriaLabel="Editor with custom tools">
      <EditorCustomTools>
        <PixataEditorCustomToolTemplate Name="InsertDate">
          <button type="button" class="pixata-blazor-button pixata-blazor-button-md pixata-blazor-rounded-md pixata-blazor-button-solid pixata-blazor-button-base" @onclick="PixataInsertDate">Insert date</button>
        </PixataEditorCustomToolTemplate>
        <PixataEditorCustomToolTemplate Name="Signature">
          <button type="button" class="pixata-blazor-button pixata-blazor-button-md pixata-blazor-rounded-md pixata-blazor-button-solid pixata-blazor-button-primary" @onclick="PixataInsertSignature">Sign</button>
        </PixataEditorCustomToolTemplate>
      </EditorCustomTools>
    </PixataEditor>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Running commands from code">
  <Description>
    <p><code>ExecuteAsync()</code> runs any command, as if the user had used a tool. Select some text and click the buttons.</p>
  </Description>
  <ChildContent>
    <div class="mb-2">
      <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataCommandsEditor.ExecuteAsync(new PixataEditorToolCommandArgs(PixataEditorCommands.Bold))">Bold</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataCommandsEditor.ExecuteAsync(new PixataEditorFormatCommandArgs(PixataEditorCommands.Format, Heading2))">Heading 2</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataCommandsEditor.ExecuteAsync(new PixataEditorFormatCommandArgs(PixataEditorCommands.ForeColor, Red))">Red</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataCommandsEditor.ExecuteAsync(new PixataEditorHtmlCommandArgs(PixataEditorCommands.InsertHtml, SampleTable))">Insert a table</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _pixataCommandsEditor.ExecuteAsync(new PixataEditorHtmlCommandArgs(PixataEditorCommands.ViewHtml, StartText))">Reset</button>
    </div>
    <PixataEditor @ref="_pixataCommandsEditor" @bind-Value="_pixataCommands" Height="220px" AriaLabel="Editor driven from code" />
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Sanitising">
  <Description>
    <p>The value below contains a script, an <code>onclick</code> handler, a <code>javascript:</code> link and an iframe. <code>PixataEditor</code> sanitises HTML when it is given a value and when it emits one, so none of them reach the page. The bound value only changes when the editor emits a new one, so edit the text to see the sanitised value.</p>
    <pre class="editor-sample-value">@UnsafeHtml</pre>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataUnsafe" Height="180px" AriaLabel="Editor given unsafe HTML" />
    <pre class="editor-sample-value">@_pixataUnsafe</pre>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Paste settings">
  <Description>
    <p><code>PixataEditorPasteSettings</code> in <code>EditorSettings</code> controls how pasted HTML is cleaned. These editors remove pasted <code>style</code> attributes and strip <code>span</code> tags (keeping their text), as well as cleaning up what Microsoft Word pastes. Copy some formatted text from another page or from Word and paste it in.</p>
  </Description>
  <ChildContent>
    <PixataEditor @bind-Value="_pixataPaste" Height="180px" AriaLabel="Editor with paste settings">
      <EditorSettings>
        <PixataEditorPasteSettings ConvertMsLists="true"
                                   RemoveMsClasses="true"
                                   RemoveMsStyles="true"
                                   RemoveHtmlComments="true"
                                   RemoveAttributes="_removeAttributes"
                                   StripTags="_stripTags" />
      </EditorSettings>
    </PixataEditor>
    <pre class="editor-sample-value">@_pixataPaste</pre>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="Events, debouncing and placeholder">
  <Description>
    <p>Here <code>DebounceDelay</code> is 1000ms, so the value is only updated a second after you stop typing (or when you leave the editor). <code>OnChange</code> is raised when the editor loses the focus after its value changed, and <code>OnBlur</code> whenever it loses the focus. <code>Placeholder</code> shows text while the editor is empty.</p>
  </Description>
  <ChildContent>
    <PixataEditor Value="@_pixataEvents"
                  ValueChanged="@((string v) => { _pixataEvents = v; _pixataLog.Insert(0, $"ValueChanged ({v.Length} characters)"); })"
                  DebounceDelay="1000"
                  Placeholder="Type something here..."
                  OnChange="@((string v) => _pixataLog.Insert(0, $"OnChange ({v.Length} characters)"))"
                  OnBlur="@(() => _pixataLog.Insert(0, "OnBlur"))"
                  Height="160px"
                  AriaLabel="Editor with events" />
    <ul class="editor-sample-log">
      @foreach (string entry in _pixataLog.Take(6)) {
        <li>@entry</li>
      }
    </ul>
  </ChildContent>
</ComponentSample>

<ComponentSample Title="In an EditForm">
  <Description>
    <p>Both editors are bound to a property marked <code>[Required]</code> with a <code>[MaxLength(200)]</code> on the HTML. Clear the text and press Save to see the invalid state.</p>
  </Description>
  <ChildContent>
    <EditForm Model="_pixataModel" OnValidSubmit="() => _pixataSaved = DateTime.Now">
      <DataAnnotationsValidator />
      <PixataEditor @bind-Value="_pixataModel.Notes" Height="160px" AriaLabel="Notes" />
      <ValidationMessage For="() => _pixataModel.Notes" />
      <button type="submit" class="btn btn-sm btn-primary mt-2">Save</button>
      @if (_pixataSaved is not null) {
        <span class="ms-2">Saved at @_pixataSaved.Value.ToLongTimeString()</span>
      }
    </EditForm>
  </ChildContent>
</ComponentSample>

<style>
  .editor-sample-value {
    max-height: 10rem;
    margin: .5rem 0 0;
    padding: .5rem;
    overflow: auto;
    background-color: #f8f9fa;
    font-size: .75rem;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .editor-sample-page-styles p {
    color: #1a3f8f;
    font-style: italic;
  }

  .editor-sample-log {
    margin: .5rem 0 0;
    padding-inline-start: 1.25rem;
    font-size: .875rem;
  }
</style>

@code {

  private const string Heading2 = "h2";
  private const string Red = "#e61919";

  private const string StartText = "<p>The <strong>quick</strong> brown fox <em>jumps</em> over the <u>lazy</u> dog.</p><ul><li>One</li><li>Two</li></ul>";

  private const string SampleTable = "<table><tbody><tr><td>One</td><td>Two</td></tr><tr><td>Three</td><td>Four</td></tr></tbody></table>";

  private const string UnsafeHtml = "<p onclick=\"alert('clicked')\">Click <a href=\"javascript:alert('link')\">this link</a> or <a href=\"https://www.example.com\" onmouseover=\"alert('hover')\">this one</a>.</p><script>alert('script')</script><iframe src=\"https://www.example.com\"></iframe><p style=\"color: red; background-image: url(javascript:alert(1))\">Red text</p>";

  private const string AllText = "<h2>All the tools</h2><p>Some <strong>bold</strong>, <em>italic</em>, <u>underlined</u> and <s>struck through</s> text, with H<sub>2</sub>O and E = mc<sup>2</sup>.</p><p style=\"text-align: center;\"><span style=\"color: #1237a5; font-family: Georgia, Times, 'Times New Roman', serif;\">A centred line in blue</span></p><ol><li>First</li><li>Second</li></ol><table><tbody><tr><td>One</td><td>Two</td></tr><tr><td>Three</td><td>Four</td></tr></tbody></table><p>A <a href=\"https://www.pixata.co.uk\">link</a>.</p>";

  private string _pixataBasic = StartText;
  private string _pixataAll = AllText;
  private string _pixataDiv = StartText;
  private string _pixataAdaptive = StartText;
  private int _adaptiveWidth = 420;
  private string _pixataReadOnly = StartText;
  private bool _readOnly = true;
  private bool _enabled = true;
  private string _pixataCustom = "<p>Put the cursor somewhere and use the custom tools.</p>";
  private string _pixataCommands = StartText;
  private string _pixataUnsafe = UnsafeHtml;
  private string _pixataPaste = "<p>Paste here.</p>";
  private string _pixataEvents = "";
  private readonly List<string> _pixataLog = [];
  private readonly NotesModel _pixataModel = new();
  private DateTime? _pixataSaved;
  private readonly List<string> _removeAttributes = ["style"];
  private readonly List<string> _stripTags = ["span", "font"];

  private PixataEditor _pixataCustomEditor = null!;
  private PixataEditor _pixataCommandsEditor = null!;

  private readonly List<PixataEditorTool> _pixataCustomTools = [
    new PixataEditorButtonGroup(new PixataEditorBold(), new PixataEditorItalic(), new PixataEditorUnderline()),
    new PixataEditorCustomTool("InsertDate"),
    new PixataEditorCustomTool("Signature")
  ];

  private Task PixataInsertDate() =>
    _pixataCustomEditor.ExecuteAsync(new PixataEditorHtmlCommandArgs(PixataEditorCommands.InsertHtml, DateTime.Today.ToLongDateString(), true));

  private Task PixataInsertSignature() =>
    _pixataCustomEditor.ExecuteAsync(new PixataEditorHtmlCommandArgs(PixataEditorCommands.InsertHtml, "<p>Kind regards,</p><p><strong>The Pixata team</strong></p>"));

  private class NotesModel {
    [Required(ErrorMessage = "Please enter some notes")]
    [MaxLength(200, ErrorMessage = "The notes can be at most 200 characters of HTML")]
    public string Notes { get; set; } = "<p>Some notes</p>";
  }

}
